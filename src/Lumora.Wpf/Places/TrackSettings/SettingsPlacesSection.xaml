<UserControl x:Class="Lumora.Places.TrackSettings.SettingsPlacesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Places.TrackSettings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:PlacesSettingsViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000">
    <!-- Einstellungen › Orte (ADR-0062, Mockup 10): „Garmin-Aktivitäten (GPS-Spuren der Uhr)“ und „Zeitabgleich“.
         DataContext = PlacesSettingsViewModel (SettingsPage). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Settings/Sections/SettingsStyles.xaml" />
                <ResourceDictionary Source="../Suggestions/PlacesSuggestionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Step" TargetType="Border">
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StepNumber" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="TextElement.FontWeight" Value="Bold" />
                <Setter Property="TextElement.FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SectionPanel}">
            <TextBlock Style="{StaticResource Lead}"
                       Text="Handy-Fotos ohne GPS-Höhe und -Zeit haben oft nur eine Schätzung über Mobilfunk/WLAN als Ort. Lumora schlägt bessere Orte aus Ihren GPS-Spuren und aus zeitnahen Fotos mit echtem GPS vor (Seite Orte › Ungenau). Alles bleibt auf diesem PC." />

            <!-- Garmin-Aktivitäten -->
            <Border Style="{StaticResource SectionCard}" AutomationProperties.AutomationId="SettingsPlacesGarmin">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Run24" Margin="0,0,8,0" Foreground="{StaticResource PlacesTrackBrush}" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Garmin-Aktivitäten (GPS-Spuren der Uhr)" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Lumora vergleicht die Aufnahmezeit jedes Fotos mit Ihren Aktivitäten und setzt den Ort laut Uhr. Garmin bietet Privatpersonen keinen API-Schlüssel an (die Connect-API gibt es nur für Firmen) — deshalb ist auch keiner nötig: Lumora liest Ihren Garmin-Datenexport bzw. FIT-/GPX-Dateien ein. Es wird nichts an Garmin gesendet." />

                    <!-- Schritt 1 -->
                    <Border Style="{StaticResource Step}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
                                       Icon="{ui:SymbolIcon Open24}" Content="Garmin-Datenexport öffnen"
                                       AutomationProperties.AutomationId="SettingsPlacesOpenExport"
                                       Command="{Binding OpenGarminExportCommand}" />
                            <Border Style="{StaticResource StepNumber}" DockPanel.Dock="Left"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Export bei Garmin anfordern" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Im Garmin-Konto unter Datenverwaltung › „Daten exportieren“. Garmin schickt nach einiger Zeit einen Download-Link per E-Mail (ZIP mit allen Aktivitäten)." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Schritt 2 -->
                    <Border Style="{StaticResource Step}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon FolderZip24}" Content="Export-ZIP einlesen…"
                                           HorizontalAlignment="Stretch"
                                           AutomationProperties.AutomationId="SettingsPlacesImportZip"
                                           Command="{Binding ImportExportZipCommand}" />
                                <ui:Button Margin="0,6,0,0" Icon="{ui:SymbolIcon DocumentAdd24}" Content="FIT/GPX-Dateien…"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding ImportFilesCommand}" />
                            </StackPanel>
                            <Border Style="{StaticResource StepNumber}" DockPanel.Dock="Left"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="ZIP einlesen" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Die heruntergeladene ZIP-Datei auswählen. Lumora liest die FIT-Dateien daraus (auch aus den inneren ZIPs, einmalig, dauert einige Minuten). Schon eingelesene Aktivitäten werden übersprungen." />
                                <!-- Fortschritt -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Height="4" Maximum="100" Value="{Binding ImportProgress}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="Abbrechen" Padding="8,2" FontSize="12"
                                                   AutomationProperties.Name="Einlesen abbrechen" Command="{Binding CancelImportCommand}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ImportProgressText}" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="SettingsPlacesImportProgress" />
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding ImportResultText}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="SettingsPlacesImportResult"
                                           Visibility="{Binding HasImportResult, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Schritt 3 -->
                    <Border Style="{StaticResource Step}">
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}" DockPanel.Dock="Left"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Neue Touren laufend ergänzen" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Ordner mit FIT-/GPX-Dateien beobachten (z. B. den Ablageordner von Garmin Express), oder die Uhr per USB anschließen." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Padding="8,4" CornerRadius="4" MinWidth="260" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding WatchFolderText}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                   AutomationProperties.AutomationId="SettingsPlacesWatchFolder" />
                                    </Border>
                                    <ui:Button Margin="8,0,0,0" Content="Ordner…" Command="{Binding ChooseWatchFolderCommand}" />
                                    <ui:Button Margin="6,0,0,0" Content="Nicht mehr beobachten"
                                               Visibility="{Binding HasWatchFolder, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding ClearWatchFolderCommand}" />
                                </StackPanel>
                                <ui:ToggleSwitch Margin="0,10,0,0" IsChecked="{Binding UsbDetection, Mode=TwoWay}"
                                                 AutomationProperties.Name="Garmin-Uhr per USB erkennen"
                                                 Content="Garmin-Uhr per USB erkennen und neue Aktivitäten einlesen (vorher fragen)" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Funktioniert mit Uhren, die als Laufwerk erscheinen (Ordner GARMIN\Activity). Neuere Uhren (z. B. Fenix 6/7) melden sich per MTP wie ein Handy und sind kein Laufwerk — dann den Datenexport oder den Ordner von Garmin Express verwenden." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Stand -->
                    <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Aktivitäten anzeigen" Command="{Binding ToggleActivitiesCommand}"
                                           AutomationProperties.AutomationId="SettingsPlacesShowActivities" />
                                <ui:Button Margin="8,0,0,0" Content="Spuren entfernen…" Command="{Binding RemoveTracksCommand}"
                                           AutomationProperties.AutomationId="SettingsPlacesRemoveTracks" />
                            </StackPanel>
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding HasActivities, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="SettingsPlacesSummary" />
                        </DockPanel>
                    </Border>

                    <!-- Aktivitäten (einfache Liste) -->
                    <ListView Margin="0,10,0,0" MaxHeight="320" ItemsSource="{Binding Activities}"
                              AutomationProperties.Name="Eingelesene Aktivitäten"
                              VirtualizingPanel.IsVirtualizing="True"
                              Visibility="{Binding IsActivitiesOpen, Converter={StaticResource BoolToVis}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Beginn" Width="170" DisplayMemberBinding="{Binding Date}" />
                                <GridViewColumn Header="Dauer" Width="90" DisplayMemberBinding="{Binding Duration}" />
                                <GridViewColumn Header="Aktivität" Width="170" DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Gerät" Width="130" DisplayMemberBinding="{Binding Device}" />
                                <GridViewColumn Header="Strecke" Width="90" DisplayMemberBinding="{Binding Distance}" />
                                <GridViewColumn Header="Punkte" Width="80" DisplayMemberBinding="{Binding Points}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Zeitabgleich -->
            <Border Style="{StaticResource SectionCard}" AutomationProperties.AutomationId="SettingsPlacesTime">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Zeitabgleich" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="Zeitzone der Fotos" Width="180" />
                        <ComboBox Width="460" ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone, Mode=TwoWay}"
                                  AutomationProperties.Name="Zeitzone der Fotos" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="180,4,0,0" TextWrapping="Wrap"
                               Text="Gilt nur für Fotos ohne Zeitzonen-Angabe und ohne GPS-Zeit — ältere Kameras speichern nur die Uhrzeit." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Toleranz" Width="180" />
                        <ComboBox Width="160" ItemsSource="{Binding ToleranceOptions}" SelectedItem="{Binding SelectedTolerance, Mode=TwoWay}"
                                  AutomationProperties.Name="Toleranz" />
                        <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Fotos so lange vor/nach einer Aktivität zählen noch." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Margin="0,14,0,4" Text="Kamera-Abweichung" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="+ = die Kamera-Uhr geht vor. Eingabe z. B. „+3:12“ (Minuten:Sekunden), „-1:00:00“ oder Sekunden. Ermittelt wird nur bei Kameras mit eigenem GPS-Zeitstempel — sonst von Hand." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Noch keine Kameras im Katalog (Angaben werden im Hintergrund gelesen)."
                               Visibility="{Binding HasCameras, Converter={StaticResource InvBoolToVis}}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Cameras}" AutomationProperties.Name="Kamera-Abweichungen">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CameraOffsetRow}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Camera}" Width="220" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Camera}" />
                                    <TextBlock Text="{Binding CountText}" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Width="130" Text="{Binding OffsetText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Camera}" />
                                    <TextBlock Margin="12,0,0,0" Text="{Binding SuggestionText}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Margin="8,0,0,0" Content="übernehmen" Padding="8,2" FontSize="12" Appearance="Transparent"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding CanApplySuggestion, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding ApplySuggestionCommand}" />
                                    <TextBlock Margin="8,0,0,0" Text="ungültig" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Vorrang" Width="180" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" MaxWidth="560"
                                   Text="Zeit: Zeitzonen-Angabe der Datei › GPS-Zeit des Fotos › Zeitzone oben. Ort: GPS-Spur › Foto mit echtem GPS › Handy-Schätzung. Von Hand gesetzte Orte werden nie überschrieben." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

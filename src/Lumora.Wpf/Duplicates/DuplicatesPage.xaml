<UserControl x:Class="Lumora.Duplicates.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:Lumora.Shell"
             xmlns:gc="clr-namespace:Lumora.Gallery.Controls"
             xmlns:local="clr-namespace:Lumora.Duplicates"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DuplicatesViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="760">
    <!-- Seite „Doppelte“ (ADR-0053, Stil wie Galerie-Kopfzeile/Mockup 06): Titel + Trefferzeile, Umschalter „Exakt gleich |
         Ähnlich“, Filterkarte (Eingang ↔ Bibliothek, Schwelle, Angaben übertragen, Rückgängig, Übrige in den Papierkorb),
         Regel „behalten“, Gruppen als Karten mit den Dateien nebeneinander (virtualisiert). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Gallery/Controls/GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
            <shell:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <shell:NullToVisibilityConverter x:Key="NullToVis" />

            <Style x:Key="MetaText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="GroupContainer" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Eine Datei der Gruppe -->
            <DataTemplate x:Key="MemberTemplate" DataType="{x:Type local:DuplicateMemberViewModel}">
                <Border x:Name="Card"
                        Width="230"
                        Margin="0,0,10,10"
                        Padding="8"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        AutomationProperties.Name="{Binding AutomationName}"
                        ToolTip="{Binding FullPath}">
                    <StackPanel>
                        <Grid Height="160" Background="{DynamicResource ControlFillColorSecondaryBrush}" Cursor="Hand"
                              MouseLeftButtonDown="OnImageMouseDown">
                            <ui:SymbolIcon Symbol="Image24" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Image Source="{Binding Image}" Stretch="Uniform"
                                   Visibility="{Binding Image, Converter={StaticResource NullToVis}}" />
                            <Border Margin="6" Padding="4,1" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#99000000" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon Symbol="Video24" FontSize="14" Foreground="White" />
                            </Border>
                        </Grid>
                        <RadioButton Margin="0,8,0,2"
                                     GroupName="{Binding GroupName}"
                                     IsChecked="{Binding IsKeep, Mode=TwoWay}"
                                     Content="{Binding ActionText}"
                                     AutomationProperties.Name="{Binding AutomationName}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MetaText}">
                            <Run Text="{Binding ResolutionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MetaText}" Text="{Binding DateText}" />
                        <TextBlock Style="{StaticResource MetaText}" Text="{Binding FolderText}" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border x:Name="Location" Padding="6,1" CornerRadius="4" Margin="0,0,6,2"
                                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                                <TextBlock Text="{Binding LocationText}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                            <ui:SymbolIcon Symbol="Heart24" Filled="True" FontSize="13" Margin="0,0,6,2"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding RatingText}" FontSize="12" Margin="0,0,6,2"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{Binding DistanceText}" FontSize="11" Margin="0,0,6,2"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MetaText}" Text="{Binding ExtrasText}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsKeep}" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsInInbox}" Value="True">
                        <Setter TargetName="Location" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Eine Gruppe -->
            <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:DuplicateGroupViewModel}">
                <Border Margin="0,0,0,12"
                        Padding="14,12,4,4"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Loaded="OnGroupLoaded"
                        DataContextChanged="OnGroupDataContextChanged">
                    <StackPanel>
                        <DockPanel Margin="0,0,10,2">
                            <CheckBox DockPanel.Dock="Right"
                                      Content="Aufräumen"
                                      IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                      ToolTip="Diese Gruppe bei „Übrige in den Papierkorb“ berücksichtigen"
                                      AutomationProperties.Name="Gruppe aufräumen" />
                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding ReasonText}" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource MemberTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,12,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel + Trefferzeile, rechts der Umschalter -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="Doppelte" />
                <TextBlock Margin="0,2,0,0" FontSize="13" AutomationProperties.AutomationId="DuplicatesResultLine"
                           Text="{Binding SummaryText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource GallerySegmentHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="DuplicateMode"
                                 AutomationProperties.AutomationId="DuplicatesExact" AutomationProperties.Name="Exakt gleich"
                                 ToolTip="Byte für Byte gleiche Dateien (gleiche Prüfsumme)"
                                 IsChecked="{Binding IsExactMode, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="12" Margin="0,0,4,0" />
                            <TextBlock Text="Exakt gleich" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource GallerySegmentRadio}" GroupName="DuplicateMode"
                                 AutomationProperties.AutomationId="DuplicatesSimilar" AutomationProperties.Name="Ähnlich"
                                 ToolTip="Ähnliche Bilder: verkleinert, neu gespeichert, Serienaufnahmen, WhatsApp-Kopien"
                                 IsChecked="{Binding IsSimilarMode, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="12" Margin="0,0,4,0" />
                            <TextBlock Text="Ähnlich" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filterkarte -->
        <Border Grid.Row="1" Padding="12,8" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <WrapPanel>
                    <ToggleButton Style="{StaticResource GalleryFilterChip}"
                                  AutomationProperties.AutomationId="DuplicatesInboxOnly"
                                  AutomationProperties.Name="Nur Eingang, schon in der Bibliothek"
                                  ToolTip="Nur Dateien im Eingang, die byte-gleich schon in der Bibliothek liegen"
                                  IsChecked="{Binding InboxOnly, Mode=TwoWay}"
                                  gc:FilterChip.IsActive="{Binding InboxOnly}"
                                  Margin="0,0,12,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Eingang schon in der Bibliothek" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"
                                Visibility="{Binding IsSimilarMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ähnlichkeit" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource GalleryBarLabel}" />
                        <Slider Width="160" VerticalAlignment="Center"
                                Minimum="{Binding MinThreshold}" Maximum="{Binding MaxThreshold}"
                                Value="{Binding Threshold, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                AutomationProperties.AutomationId="DuplicatesThreshold"
                                AutomationProperties.Name="Schwelle für ähnlich" />
                        <TextBlock Text="{Binding ThresholdText}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox Content="Angaben übertragen" Margin="0,0,16,4" VerticalAlignment="Center"
                              IsChecked="{Binding TransferMetadata, Mode=TwoWay}"
                              AutomationProperties.AutomationId="DuplicatesTransfer"
                              ToolTip="Bewertung, Favorit, Tags, Kategorien und Personen der gelöschten Dateien auf die behaltene übertragen" />
                    <ui:Button Content="{Binding UndoText}" Margin="0,0,8,4" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Command="{Binding UndoCommand}"
                               AutomationProperties.AutomationId="DuplicatesUndo"
                               ToolTip="Letzte Aufräumaktion zurücknehmen: Dateien kommen mit allen Angaben aus dem Papierkorb zurück" />
                    <ui:Button Content="{Binding CleanUpText}" Margin="0,0,8,4" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding CleanUpCommand}"
                               AutomationProperties.AutomationId="DuplicatesCleanUp"
                               ToolTip="Alle nicht als „Behalten“ markierten Dateien der angehakten Gruppen in den Papierkorb (mit Bestätigung)" />
                    <ui:Button Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                               ToolTip="Neu lesen" AutomationProperties.Name="Aktualisieren" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding RuleText}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Hinweise: Index noch nicht fertig, Ergebnis der letzten Aktion -->
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock Text="{Binding PendingText}" FontSize="12" Visibility="{Binding PendingText, Converter={StaticResource NullToVis}}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                       AutomationProperties.AutomationId="DuplicatesStatus"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Gruppen -->
        <Grid Grid.Row="3">
            <ListBox x:Name="GroupList"
                     ItemsSource="{Binding Groups}"
                     ItemTemplate="{StaticResource GroupTemplate}"
                     ItemContainerStyle="{StaticResource GroupContainer}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.AutomationId="DuplicatesGroups"
                     Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasGroups, Converter={StaticResource InverseBoolToVis}}">
                <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding EmptyText}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Center" Content="Eingang-Filter aufheben"
                           Command="{Binding ClearInboxFilterCommand}"
                           Visibility="{Binding InboxOnly, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>

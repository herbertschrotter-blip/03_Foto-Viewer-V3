<UserControl x:Class="Lumora.Slideshow.SlideshowOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Slideshow"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SlideshowViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             Focusable="False"
             IsTabStop="False">

    <!--
        Overlay der Diashow (Mockup 09 „Diashow“): Datum und Ort unten links, Bedienleiste unten mittig (blendet sich nach
        2 s ohne Mausbewegung aus), Titel oben rechts, Fortschrittsbalken unten. Zweimal instanziiert: über den Bildern
        direkt im Fenster und als VideoView.Content über Videos (LibVLCSharp rendert ihn in einem Vordergrundfenster, Airspace).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SlideshowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="CaptionShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.7" Color="Black" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Fläche für Mausbewegung (Video-Modus), sonst durchsichtig -->
        <Border x:Name="Surface" Background="#01000000" />

        <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <TextBlock Text="{Binding StatusText}" MaxWidth="560" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" IsHitTestVisible="False"
                   Foreground="{DynamicResource LightboxTextBrush}"
                   AutomationProperties.AutomationId="SlideshowStatus"
                   Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}" />

        <!-- Titel oben rechts (mit der Leiste) -->
        <TextBlock Text="{Binding Title}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"
                   FontSize="13" Opacity="0.8" IsHitTestVisible="False" Effect="{StaticResource CaptionShadow}"
                   Foreground="{DynamicResource SlideshowCaptionBrush}"
                   Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}" />

        <!-- Datum und Ort unten links -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,34" IsHitTestVisible="False"
                    AutomationProperties.AutomationId="SlideshowCaption"
                    Visibility="{Binding IsCaptionVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding DateText}" FontSize="24" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="{DynamicResource SlideshowCaptionBrush}" Effect="{StaticResource CaptionShadow}"
                       Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding PlaceText}" FontSize="15" Opacity="0.9" Margin="0,2,0,0"
                       Foreground="{DynamicResource SlideshowCaptionBrush}" Effect="{StaticResource CaptionShadow}"
                       Visibility="{Binding HasPlace, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Bedienleiste unten mittig -->
        <Border x:Name="Bar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="10,6"
                CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SlideshowBarBrush}" BorderBrush="{DynamicResource SlideshowBarBorderBrush}"
                AutomationProperties.AutomationId="SlideshowBar"
                Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource LightboxOverlayButton}" Command="{Binding PreviousCommand}"
                        ToolTip="Zurück (←)" AutomationProperties.Name="Zurück">
                    <ui:SymbolIcon Symbol="Previous24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource LightboxOverlayButton}" Command="{Binding TogglePauseCommand}"
                        ToolTip="Pause / Weiter (Leertaste)" AutomationProperties.Name="Pause oder Weiter">
                    <Grid>
                        <ui:SymbolIcon Symbol="Pause24" FontSize="18"
                                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                       Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource LightboxOverlayButton}" Command="{Binding NextCommand}"
                        ToolTip="Weiter (→)" AutomationProperties.Name="Weiter">
                    <ui:SymbolIcon Symbol="Next24" FontSize="18" />
                </Button>
                <TextBlock Text="{Binding PositionText}" Margin="8,0" FontSize="12" Opacity="0.8" VerticalAlignment="Center"
                           Foreground="{DynamicResource LightboxTextBrush}" AutomationProperties.AutomationId="SlideshowPosition" />

                <Border Style="{StaticResource SlideshowDivider}" />

                <StackPanel Orientation="Horizontal" ToolTip="Anzeigedauer je Foto" AutomationProperties.Name="Anzeigedauer">
                    <RadioButton Style="{StaticResource SlideshowSegment}" Content="3 s" IsChecked="{Binding IsDuration3, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SlideshowSegment}" Content="5 s" IsChecked="{Binding IsDuration5, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SlideshowSegment}" Content="8 s" IsChecked="{Binding IsDuration8, Mode=TwoWay}" />
                </StackPanel>

                <ToggleButton Style="{StaticResource SlideshowToggle}" IsChecked="{Binding KenBurnsEnabled, Mode=TwoWay}"
                              ToolTip="Langsamer Zoom — zielt auf Gesichter, sonst auf die Bildmitte" AutomationProperties.Name="Zoom">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="15" Margin="0,0,6,0" />
                        <TextBlock Text="Zoom" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource SlideshowToggle}" IsChecked="{Binding ShowCaption, Mode=TwoWay}"
                              ToolTip="Datum und Ort einblenden" AutomationProperties.Name="Datum und Ort">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Margin="0,0,6,0" />
                        <TextBlock Text="Datum &amp; Ort" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Border Style="{StaticResource SlideshowDivider}" />

                <Button Style="{StaticResource LightboxOverlayButton}" Command="{Binding CloseCommand}"
                        ToolTip="Beenden (Esc)" AutomationProperties.Name="Diashow beenden">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Fortschrittsbalken der aktuellen Folie -->
        <Rectangle x:Name="ProgressFill" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                   Fill="{DynamicResource SlideshowProgressBrush}" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>

<UserControl x:Class="Lumora.Gallery.Places.PlaceFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gc="clr-namespace:Lumora.Gallery.Controls"
             xmlns:local="clr-namespace:Lumora.Gallery.Places"
             x:Name="Root"
             Focusable="False">
    <!--
        Chip „Ort: …“ in der Zeile „Inhalt“ (ADR-0050). Flyout: Suche, Länder → Regionen → Orte mit Anzahl (auf- und
        zuklappbar), „ohne Ortsnamen“, „ohne Ort“; ein Häkchen wirkt sofort, mehrere gelten mit ODER, zusammen mit den
        übrigen Filtern UND. Die Zähler lädt das Öffnen (LoadPlaceFilterCommand). DataContext = GalleryViewModel
        (PlaceFilterEntries, PlaceFilterSearch, PlaceFilterValueText, HasPlaceFilter, ApplyPlaceFilterCommand,
        TogglePlaceEntryCommand, ClearPlaceFilterCommand).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Auf-/Zuklapp-Knopf ohne Rahmen -->
            <Style x:Key="ExpanderButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      Style="{StaticResource GalleryFilterChip}"
                      AutomationProperties.AutomationId="GalleryPlaceFilterButton"
                      AutomationProperties.Name="{Binding PlaceFilterValueText, StringFormat='Ort-Filter: {0}'}"
                      ToolTip="Nach Aufnahmeort filtern (Land, Region, Ort)"
                      gc:FilterChip.IsActive="{Binding HasPlaceFilter}"
                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Location24" FontSize="13" Margin="0,0,6,0" />
                <TextBlock Text="Ort:" Style="{StaticResource GalleryChipLabel}" />
                <TextBlock Text="{Binding PlaceFilterValueText}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Style="{StaticResource GalleryFlyoutBorder}" Width="340" MaxHeight="560">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WO WURDE AUFGENOMMEN?" Style="{StaticResource GalleryFlyoutHeading}" />
                        <ui:TextBox x:Name="SearchBox"
                                    Margin="0,0,0,6"
                                    PlaceholderText="Land, Region oder Ort suchen"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    AutomationProperties.Name="Ort im Filter suchen"
                                    Text="{Binding PlaceFilterSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Orte werden geladen…" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsLoadingPlaces, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Mehrere Häkchen: eines davon (ODER) — zusammen mit den anderen Filtern (UND). Ortsnamen: GeoNames (offline)."
                                   Style="{StaticResource GalleryFlyoutHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="Leeren" ToolTip="Ort-Filter aufheben" Command="{Binding ClearPlaceFilterCommand}" Click="OnCloseClick" Margin="0,0,6,0" />
                            <ui:Button Content="Fertig" Appearance="Primary" Click="OnCloseClick" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl x:Name="PlaceList"
                                  ItemsSource="{Binding PlaceFilterEntries}"
                                  AutomationProperties.Name="Orte"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PlaceFilterEntry}">
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Button x:Name="Expander" Style="{StaticResource ExpanderButton}"
                                            Content="{Binding ExpanderGlyph}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='{}{0} auf- oder zuklappen'}"
                                            Command="{Binding DataContext.TogglePlaceEntryCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" />
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="2,1"
                                              AutomationProperties.Name="{Binding Name}"
                                              Command="{Binding DataContext.ApplyPlaceFilterCommand, ElementName=Root}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Country">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="WithoutLocation">
                                        <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="WithoutPlaceName">
                                        <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

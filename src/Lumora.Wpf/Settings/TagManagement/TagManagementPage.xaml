<UserControl x:Class="Lumora.Settings.TagManagement.TagManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:Lumora.Shell"
             xmlns:local="clr-namespace:Lumora.Settings.TagManagement"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TagManagementViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             x:Name="Root">
    <!-- Tag-Verwaltung (ADR-0021): Liste mit Farbe, Zähler, Palette, Reihenfolge, Umbenennen, Löschen; oben „Neues Tag“. -->
    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Farbfeld der Palette: runder Punkt, aktuelle Farbe mit Rahmen -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12,24,16" MaxWidth="960" HorizontalAlignment="Left">
            <!-- Reiter „Tags“ der Einstellungen (ADR-0042): Überschrift = Reiter -->
            <TextBlock Text="Frei definierbare Schlagworte. Zuweisen in der Galerie über die Aktionsleiste, das Kontextmenü oder Strg+T."
                       FontSize="12" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:InfoBar Title="Fehler" Severity="Error" Message="{Binding ErrorMessage}"
                        IsOpen="{Binding IsErrorOpen, Mode=TwoWay}" Margin="0,0,0,12" />
            <ui:InfoBar Severity="Success" Message="{Binding InfoMessage}"
                        IsOpen="{Binding IsInfoOpen, Mode=TwoWay}" Margin="0,0,0,12" />

            <!-- Neues Tag -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                AutomationProperties.AutomationId="NewTagName"
                                PlaceholderText="Neues Tag…"
                                Icon="{ui:SymbolIcon Tag24}"
                                Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="OnNewTagKeyDown" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Content="Anlegen"
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding CreateCommand}" />
                    <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                               Text="{Binding SummaryText}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- Liste -->
            <Border Style="{StaticResource SectionCard}" Padding="8">
                <StackPanel>
                    <TextBlock Margin="8" Text="Noch keine Tags — oben einen Namen eingeben und „Anlegen“."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Tags}" AutomationProperties.AutomationId="TagManagementList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TagManagementRow}">
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Margin="0,0,10,0"
                                            Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding FileCountText, Mode=OneWay}" FontSize="11"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </TextBlock>

                                    <!-- Palette -->
                                    <ItemsControl Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Focusable="False"
                                                  ItemsSource="{Binding ColorChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:TagColorChoice}">
                                                <Button x:Name="Swatch"
                                                        Style="{StaticResource SwatchButton}"
                                                        Background="{Binding Brush}"
                                                        ToolTip="{Binding Color}"
                                                        AutomationProperties.Name="{Binding Color}"
                                                        Command="{Binding DataContext.SetColorCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowUp24}"
                                                   ToolTip="Nach oben" AutomationProperties.Name="Nach oben"
                                                   IsEnabled="{Binding CanMoveUp}"
                                                   Command="{Binding DataContext.MoveUpCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Padding="6" Icon="{ui:SymbolIcon ArrowDown24}"
                                                   ToolTip="Nach unten" AutomationProperties.Name="Nach unten"
                                                   IsEnabled="{Binding CanMoveDown}"
                                                   Command="{Binding DataContext.MoveDownCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ui:Button Appearance="Transparent" Content="Umbenennen" Icon="{ui:SymbolIcon Rename24}"
                                                   Command="{Binding DataContext.RenameCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Content="Löschen" Icon="{ui:SymbolIcon Delete24}" Margin="4,0,0,0"
                                                   Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

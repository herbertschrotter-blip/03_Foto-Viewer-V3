<UserControl x:Class="Lumora.Settings.Sections.SettingsMapSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Settings.Sections"
             xmlns:styles="clr-namespace:Lumora.Places.Styles"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance styles:MapStyleSettingsViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="900">
    <!-- Einstellungen › Darstellung › Karte (ADR-0055): Kartenstil der Seite „Orte“ und je Kartendienst (CARTO, MapTiler) eine
         vorgeschlagene Karte „Kartendienst“ mit Schlüssel, Prüfen, Website, E-Mail, Konto, Notiz und Lumoras Zählung.
         DataContext = MapStyleSettingsViewModel (von der SettingsPage gesetzt). -->
    <UserControl.Resources>
        <ResourceDictionary Source="SettingsStyles.xaml" />
    </UserControl.Resources>

    <Border Style="{StaticResource SectionCard}">
        <StackPanel>
            <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Karte (Seite „Orte“)" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Kartenstil" Width="130" />
                <ComboBox Width="280"
                          AutomationProperties.AutomationId="SettingsMapStyle"
                          AutomationProperties.Name="Kartenstil"
                          ItemsSource="{Binding StyleOptions}"
                          SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="142,6,0,0" Text="{Binding SelectedStyle.Description}" />
            <Border Margin="142,8,0,0" Padding="10,6" CornerRadius="6" HorizontalAlignment="Left"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    AutomationProperties.AutomationId="SettingsMapStyleHint"
                    Visibility="{Binding HasStyleHint, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StyleHint}" TextWrapping="Wrap" FontSize="12" MaxWidth="600" />
            </Border>

            <!-- Kartendienste: vorgeschlagen, auch ohne Schlüssel -->
            <local:SettingsMapServiceCard DataContext="{Binding Carto}" />
            <local:SettingsMapServiceCard DataContext="{Binding MapTiler}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" Content="Kartendienste speichern" Command="{Binding SaveCommand}"
                           AutomationProperties.AutomationId="SettingsMapSave" />
                <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SavedText}"
                           Visibility="{Binding SavedText, Converter={StaticResource NullToVis}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="Ohne Schlüssel bleibt die OpenStreetMap-Standardkarte. „API-Schlüssel anfordern…“, „Website öffnen“ und „Konto öffnen“ öffnen nur den Browser — Lumora registriert nichts und sendet selbst keine Daten. Schlüssel, E-Mail-Adresse und Notizen stehen unverschlüsselt in der Datenbank dieses Katalogs und nie im Protokoll; eine versteckte Bibliothek hat eigene Einstellungen. Den Verbrauch zählt nur der Anbieter verbindlich — Lumoras Zahl umfasst die Abrufe dieses Katalogs auf diesem PC." />
        </StackPanel>
    </Border>
</UserControl>

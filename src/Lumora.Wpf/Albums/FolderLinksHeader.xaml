<UserControl x:Class="Lumora.Albums.FolderLinksHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lumora.Albums"
             Focusable="False">
    <!--
        Ordneransicht (ADR-0054): Schalter „mit Verknüpfungen“ (Standard) / „nur echte Dateien“ und Zähler
        „12 Dateien · 5 verknüpft“. DataContext = GalleryViewModel (IncludeFolderLinks, HasFolderLinks, FolderLinksText).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Gallery/Controls/GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolOptionConverter x:Key="BoolOption" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Border Style="{StaticResource GallerySegmentHost}" AutomationProperties.Name="Verknüpfte Fotos im Ordner">
            <StackPanel Orientation="Horizontal">
                <!-- Ohne GroupName: Gruppe = dieses StackPanel (die Galerie existiert zweimal, ADR-0054) -->
                <RadioButton Style="{StaticResource GallerySegmentRadio}"
                             AutomationProperties.AutomationId="FolderWithLinks"
                             AutomationProperties.Name="Mit Verknüpfungen"
                             ToolTip="Echte Dateien des Ordners und dorthin verknüpfte Fotos zeigen"
                             IsChecked="{Binding IncludeFolderLinks, Converter={StaticResource BoolOption}, ConverterParameter=True}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Link16" FontSize="12" Margin="0,0,4,0" />
                        <TextBlock Text="mit Verknüpfungen" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource GallerySegmentRadio}"
                             AutomationProperties.AutomationId="FolderRealOnly"
                             AutomationProperties.Name="Nur echte Dateien"
                             ToolTip="Nur Dateien zeigen, die wirklich in diesem Ordner liegen"
                             IsChecked="{Binding IncludeFolderLinks, Converter={StaticResource BoolOption}, ConverterParameter=False}"
                             Content="nur echte Dateien" />
            </StackPanel>
        </Border>
        <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                   AutomationProperties.AutomationId="FolderLinksCount"
                   Text="{Binding FolderLinksText}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasFolderLinks, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>

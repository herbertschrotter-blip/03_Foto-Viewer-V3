<UserControl x:Class="Lumora.Sorter.Views.FileSorterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Lumora.Sorter.ViewModels"
             xmlns:conv="clr-namespace:Lumora.Sorter.Converters"
             xmlns:views="clr-namespace:Lumora.Sorter.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FileSorterViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000"
             d:DesignHeight="900"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:SorterInverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:SorterInverseBoolConverter x:Key="InverseBool" />
        <conv:SorterStringToVisibilityConverter x:Key="StringToVis" />
        <conv:SorterCountToVisibilityConverter x:Key="CountToVis" />

        <!-- Schlichte Zeilen ohne Standard-ListBoxItem-Chrome: Hover-Hintergrund, Markierung = Akzentbalken links -->
        <ControlTemplate x:Key="RowTemplate" TargetType="ListBoxItem">
            <Border x:Name="Row"
                    Background="Transparent"
                    BorderThickness="3,0,0,0"
                    BorderBrush="Transparent"
                    Padding="8,4">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="GroupRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsMarked, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
        </Style>

        <Style x:Key="PlainRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WarnText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#F7B955" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Pattern-Zeile (Stufe 1) -->
        <DataTemplate x:Key="PatternRowTemplate" DataType="{x:Type vm:PatternRowViewModel}">
            <StackPanel Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" ToolTip="Pattern aktiv" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" Margin="0,0,6,0" ToolTip="Eindeutiger Name" />
                    <ui:TextBox Grid.Column="2" Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Regex (auf den Dateinamen ohne Endung)" FontFamily="Consolas" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="3" Text="{Binding GroupCaptureText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Capture-Gruppe (0 = ganzer Treffer)" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="4" Text="{Binding PriorityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Priorität (niedriger = zuerst)" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="5" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Beschreibung" Margin="0,0,6,0" />
                    <ui:Button Grid.Column="6"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="Pattern löschen (Built-in-Patterns können nur deaktiviert werden)"
                               AutomationProperties.Name="Pattern löschen"
                               IsEnabled="{Binding CanDelete}"
                               Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="28,2,0,0">
                    <TextBlock Style="{StaticResource HintText}" Text="Built-in" Margin="0,0,10,0"
                               Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Sub-Level-Zeile (Stufe 2..N) -->
        <DataTemplate x:Key="SubLevelRowTemplate" DataType="{x:Type vm:SubLevelRowViewModel}">
            <StackPanel Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" ToolTip="Ebene aktiv" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name der Ebene" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="2" Text="{Binding Regex, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Regex (auf den vollen Dateinamen mit Endung)" FontFamily="Consolas" Margin="0,0,6,0" />
                    <ui:TextBox Grid.Column="3" Text="{Binding GroupCaptureText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Capture-Gruppe" Margin="0,0,6,0" />
                    <ui:Button Grid.Column="4"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="Ebene entfernen"
                               AutomationProperties.Name="Ebene entfernen"
                               Command="{Binding DataContext.RemoveSubLevelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Margin="28,2,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Sub-Gruppen (rekursiv über DynamicResource) -->
        <DataTemplate x:Key="SubGroupTemplate" DataType="{x:Type vm:GroupRowViewModel}">
            <StackPanel>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="{Binding Indent}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsIncluded}" ToolTip="Sub-Gruppe einbeziehen" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayKey}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding PatternName}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Column="5" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ordnername dieser Ebene" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="6" Style="{StaticResource HintText}" Text="{Binding PreviewText}" VerticalAlignment="Center" FontSize="12" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource SubGroupTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Gruppe (Stufe 1) -->
        <DataTemplate x:Key="GroupRowTemplate" DataType="{x:Type vm:GroupRowViewModel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" ToolTip="Gruppe sortieren" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding PatternName}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" VerticalAlignment="Center" ToolTip="Dateien (davon nicht im Katalog in Klammern)" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Column="4"
                                Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Zielordner"
                                ToolTip="Zielordnername (änderbar)"
                                IsEnabled="{Binding IsIncluded}"
                                Margin="0,0,8,0" />
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding PreviewText}" FontSize="12" ToolTip="{Binding PreviewText}" />
                        <TextBlock Style="{StaticResource WarnText}" Text="{Binding FolderHint}"
                                   Visibility="{Binding FolderHint, Converter={StaticResource StringToVis}}" />
                        <TextBlock Style="{StaticResource WarnText}" Text="{Binding CatalogHint}"
                                   Visibility="{Binding CatalogHint, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Children}"
                              ItemTemplate="{StaticResource SubGroupTemplate}"
                              Margin="0,2,0,0"
                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Plan-Zeile -->
        <DataTemplate x:Key="PlanRowTemplate" DataType="{x:Type vm:PlanRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" FontSize="14" Foreground="#4CC38A"
                               Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" />
                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="14" Foreground="#F7B955"
                               Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.SourcePath}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.DestPath}">
                    <Run Text="{Binding SourceDisplay, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text=" → " />
                    <Run Text="{Binding TargetDisplay, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource WarnText}" Text="{Binding Note}"
                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
        <StackPanel>

            <!-- Fehler -->
            <ui:InfoBar Severity="Error"
                        IsClosable="False"
                        Title="Fehler"
                        Message="{Binding ErrorMessage}"
                        IsOpen="{Binding HasError, Mode=OneWay}"
                        Margin="0,0,0,8" />

            <!-- Quelle + Ziel (Wurzeln der Bibliothek: Eingang → Archiv) -->
            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Quelle und Ziel" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="Sortiert werden die Dateien direkt im Quellordner; die Gruppenordner entstehen unter dem Ziel (Standard: Eingang → Bibliotheksordner)." />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Primary" Content="Analysieren" Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding AnalyzeCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                   AutomationProperties.AutomationId="SorterAnalyze" />
                    </Grid>
                    <views:SorterLocationView DataContext="{Binding Location}" AutomationProperties.AutomationId="SorterLocation" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:ToggleSwitch IsChecked="{Binding IsMultiLevel}" Content="Multi-Level (Sub-Level-Patterns teilen jede Gruppe weiter)" />
                        <CheckBox IsChecked="{Binding IncludeNonMedia}" Content="Auch Nicht-Medien-Dateien anzeigen" Margin="24,0,0,0" VerticalAlignment="Center" />
                        <ui:Button Appearance="Transparent" Content="Hilfe zu Patterns" Icon="{ui:SymbolIcon QuestionCircle24}"
                                   Command="{Binding ToggleHelpCommand}" Margin="24,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Hilfe (ausklappbar) -->
            <ui:Card Margin="0,0,0,8" Padding="12" Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Regex-Grundlagen" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                               Text="Ein Pattern wird auf den Dateinamen ohne Endung angewendet. Patterns werden nach Priorität geprüft (niedrige Zahl zuerst); der erste Treffer bestimmt die Gruppe, Dateien ohne Treffer landen in „_unsorted“. Der Gruppenname ist der Text der Capture-Gruppe (Klammern), kleingeschrieben — bei Capture-Gruppe 0 der ganze Treffer." />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CodeText}" Text="." />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="beliebiges Zeichen" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CodeText}" Text="\d   \w" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="eine Ziffer   /   Buchstabe, Ziffer oder Unterstrich" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CodeText}" Text="[a-z]   [A-Z0-9]" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="eines der Zeichen aus der Klasse" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CodeText}" Text="*   +   ?" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="0 oder mehr   /   1 oder mehr   /   optional" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource CodeText}" Text="{}{n}   {n,m}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="genau n-mal   /   n- bis m-mal (z. B. \d{2,3} = 2–3 Ziffern)" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource CodeText}" Text="^   $" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Anfang / Ende des Namens — Built-in-Patterns nutzen ^, damit nur der Anfang zählt" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource CodeText}" Text="( )" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Capture-Gruppe — dieser Teil wird zum Gruppen-/Ordnernamen" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource CodeText}" Text="a|b" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Alternative (a oder b)" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource CodeText}" Text="\." />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="wörtlicher Punkt — Sonderzeichen mit \ schützen" />
                    </Grid>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Beispiele" Margin="0,4,0,4" />
                    <TextBlock Style="{StaticResource CodeText}" Text="^([a-zA-Z]{1,2}\d{2,3})      p006_0042.jpg → Gruppe „p006“  (Built-in „Prefix“, Priorität 10)" />
                    <TextBlock Style="{StaticResource CodeText}" Text="^IMG-(\d{8})-WA              IMG-20240815-WA0023.jpg → „20240815“  (Priorität 5, damit es vor „Prefix“ greift)" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource CodeText}" Text="^(IMG|DSC|DSCF|VID)[_-]?     IMG_1234.jpg → „img“, DSCF0001.jpg → „dscf“  (Kamera-Typ)" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource CodeText}" Text="^(IMG|PXL)_(\d{8})           PXL_20240815_134522.jpg → „20240815“ mit Capture-Gruppe 2" Margin="0,2,0,0" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"
                               Text="Multi-Level: Sub-Level-Patterns werden auf den vollständigen Dateinamen (mit Endung) angewendet und teilen jede Gruppe weiter, z. B. „_1_(result(?:_\d+)?)\.“ → p105\result, p105\result_1, p105\_other. Tipp: Erst „Vorschau“, dann „Sortieren“ — und „Rückgängig“ nimmt den letzten Lauf komplett zurück." />
                </StackPanel>
            </ui:Card>

            <!-- Patterns -->
            <ui:CardExpander Margin="0,0,0,8" IsExpanded="False" Icon="{ui:SymbolIcon TextBulletListTree24}">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Patterns (Stufe 1)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Patterns.Count, StringFormat=' · {0} Einträge'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PatternsError}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF6B6B"
                                   Visibility="{Binding HasPatternsError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource HintText}" Text="aktiv" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Name" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Regex" />
                        <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Gruppe" />
                        <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Priorität" />
                        <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Beschreibung" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Patterns}" ItemTemplate="{StaticResource PatternRowTemplate}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Neu" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddPatternCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Speichern" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePatternsCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Import…" Icon="{ui:SymbolIcon ArrowImport24}" ToolTip="V2-Datei file-sorter-patterns.json laden"
                                   Command="{Binding ImportPatternsCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Export…" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportPatternsCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Zurücksetzen" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetPatternsCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- Sub-Level (nur bei Multi-Level) -->
            <ui:CardExpander Margin="0,0,0,8" IsExpanded="True" Icon="{ui:SymbolIcon BranchFork24}"
                             Visibility="{Binding IsMultiLevel, Converter={StaticResource BoolToVis}}">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sub-Level (Stufe 2..N)" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SubLevels.Count, StringFormat=' · {0} Ebene(n), Reihenfolge = Ordnertiefe'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SubLevels}" ItemTemplate="{StaticResource SubLevelRowTemplate}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Ebene hinzufügen" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddSubLevelCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Zurücksetzen" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetSubLevelsCommand}" Margin="0,0,16,0" />
                        <CheckBox IsChecked="{Binding UseFlatLayout}" VerticalAlignment="Center"
                                  Content="Flache Ordnernamen wie V2 (p105-r1 statt p105\result_1)" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- Analyse-Ergebnis -->
            <ui:Card Margin="0,0,0,8" Padding="12" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Gruppen" />
                            <TextBlock Text="{Binding AnalysisSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource WarnText}" Text="{Binding AnalysisWarnings}" TextWrapping="Wrap"
                                       Visibility="{Binding AnalysisWarnings, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="Zusammenführen" Icon="{ui:SymbolIcon Merge24}"
                                       ToolTip="Markierte Gruppen (Strg/Umschalt + Klick) in die erste markierte Gruppe zusammenführen"
                                       Command="{Binding MergeMarkedGroupsCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Alle" ToolTip="Alle Gruppen einbeziehen" Command="{Binding IncludeAllGroupsCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Keine" ToolTip="Keine Gruppe einbeziehen" Command="{Binding ExcludeAllGroupsCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="8,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource HintText}" Text="sortieren" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Schlüssel / Pattern" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Anzahl" />
                        <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Größe" />
                        <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Zielordner (änderbar)" />
                        <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Beispiele / Hinweise" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Groups}"
                             ItemTemplate="{StaticResource GroupRowTemplate}"
                             ItemContainerStyle="{StaticResource GroupRowContainerStyle}"
                             SelectionMode="Extended"
                             MaxHeight="440"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="SorterGroups" />
                </StackPanel>
            </ui:Card>

            <!-- Optionen + Aktionen -->
            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Optionen" Margin="0,0,0,6" />
                    <TextBlock Margin="0,0,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location.TargetRootDisplay}">
                        <Run Text="Ziel:" />
                        <Run Text="{Binding Location.TargetFolderDisplay, Mode=OneWay}" />
                        <Run Text="·" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding Location.TargetHint, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding UnsortedToFolder}" Content="„_unsorted“ in Ordner „_unsorted“ verschieben (sonst bleibt es liegen)" />
                        <CheckBox IsChecked="{Binding DeleteEmptySource}" Margin="24,0,0,0"
                                  Content="Leeren Quellordner danach löschen (nur bei Zielordner außerhalb des Quellordners)" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,12,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Vorschau" Icon="{ui:SymbolIcon Eye24}" Command="{Binding PreviewCommand}" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" Appearance="Primary" Content="Sortieren" Icon="{ui:SymbolIcon FolderArrowRight24}"
                                   Command="{Binding ExecuteCommand}" Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="SorterExecute" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}" Height="6" />
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ProgressText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="3" Content="Rückgängig (letzter Lauf)" Icon="{ui:SymbolIcon ArrowUndo24}"
                                   ToolTip="{Binding LastRunText}" Command="{Binding UndoCommand}" Margin="16,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding LastRunText}" Margin="0,8,0,0"
                               Visibility="{Binding LastRunText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ui:Card>

            <!-- Plan-Vorschau -->
            <ui:Card Margin="0,0,0,8" Padding="12" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Vorschau: Quelle → Ziel" />
                    <TextBlock Text="{Binding PlanSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <ui:InfoBar Severity="Error"
                                IsClosable="False"
                                Title="Ziel gesperrt"
                                Message="{Binding PlanTargetError}"
                                IsOpen="{Binding PlanTargetBlocked, Mode=OneWay}"
                                Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding PlanRows}"
                             ItemTemplate="{StaticResource PlanRowTemplate}"
                             ItemContainerStyle="{StaticResource PlainRowContainerStyle}"
                             MaxHeight="360"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </ui:Card>

            <!-- Status -->
            <Border Padding="10,6" CornerRadius="4" Background="{DynamicResource LayerFillColorAltBrush}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

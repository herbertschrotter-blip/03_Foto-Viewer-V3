<UserControl x:Class="Lumora.Sorter.Views.FlattenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Lumora.Sorter.ViewModels"
             xmlns:conv="clr-namespace:Lumora.Sorter.Converters"
             xmlns:views="clr-namespace:Lumora.Sorter.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FlattenViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000"
             d:DesignHeight="800"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:SorterStringToVisibilityConverter x:Key="StringToVis" />

        <ControlTemplate x:Key="RowTemplate" TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" Padding="8,4">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PlainRowContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WarnText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#F7B955" />
        </Style>

        <!-- Quellordner-Zeile -->
        <DataTemplate x:Key="FolderRowTemplate" DataType="{x:Type vm:FlattenFolderRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" ToolTip="Ordner einbeziehen" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding PathDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder.AbsolutePath}" />
                <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="4"
                            Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Zielordnername"
                            ToolTip="Zielordner unter der Zielwurzel (V2-Regel: Pfad-Ebenen dedupliziert und verbunden)"
                            IsEnabled="{Binding IsIncluded}"
                            Margin="0,0,8,0" />
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding PreviewText}" FontSize="12" ToolTip="{Binding PreviewText}" />
                    <TextBlock Style="{StaticResource WarnText}" Text="{Binding CatalogHint}"
                               Visibility="{Binding CatalogHint, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlanRowTemplate" DataType="{x:Type vm:PlanRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" FontSize="14" Foreground="#4CC38A"
                               Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" />
                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="14" Foreground="#F7B955"
                               Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.SourcePath}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.DestPath}">
                    <Run Text="{Binding SourceDisplay, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text=" → " />
                    <Run Text="{Binding TargetDisplay, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource WarnText}" Text="{Binding Note}"
                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
        <StackPanel>

            <ui:InfoBar Severity="Error"
                        IsClosable="False"
                        Title="Fehler"
                        Message="{Binding ErrorMessage}"
                        IsOpen="{Binding HasError, Mode=OneWay}"
                        Margin="0,0,0,8" />

            <!-- Quelle + Ziel -->
            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Flatten &amp; Move" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8"
                               Text="Alle Mediendateien aus Unterordnern beliebiger Tiefe werden nach Ziel\Ebenenname\Datei verschoben. Der Ebenenname entsteht aus den Pfad-Ebenen (Duplikate entfernt, mit Separator verbunden: test01\test01\raw → test01_raw); Dateien direkt in der Quellwurzel heißen „_root“. Namenskonflikte im Ziel erhalten „_1“, „_2“, …" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:SorterLocationView Grid.Column="0" DataContext="{Binding Location}" AutomationProperties.AutomationId="FlattenLocation" />
                        <ui:Button Grid.Column="1" Appearance="Primary" Content="Analysieren" Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding AnalyzeCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                   AutomationProperties.AutomationId="FlattenAnalyze" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Separator:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ui:TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="Trennzeichen zwischen den Pfad-Ebenen (wirkt ab der nächsten Analyse)" />
                        <CheckBox IsChecked="{Binding DirectToTargetRoot}" Content="Direkt in die Zielwurzel (ohne Ordner-Ebene)" Margin="24,0,0,0" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding DeleteEmptySource}" Content="Leere Quellordner danach löschen (nur wirklich leere)" Margin="24,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Ordner-Vorschau -->
            <ui:Card Margin="0,0,0,8" Padding="12" Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Quellordner mit Mediendateien" />
                            <TextBlock Text="{Binding AnalysisSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource WarnText}" Text="{Binding AnalysisWarnings}" TextWrapping="Wrap"
                                       Visibility="{Binding AnalysisWarnings, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="Alle" Command="{Binding IncludeAllCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Keine" Command="{Binding ExcludeAllCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="8,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource HintText}" Text="einbeziehen" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Text="Quellordner (relativ)" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="Anzahl" />
                        <TextBlock Grid.Column="3" Style="{StaticResource HintText}" Text="Größe" />
                        <TextBlock Grid.Column="4" Style="{StaticResource HintText}" Text="Zielordner (änderbar)" />
                        <TextBlock Grid.Column="5" Style="{StaticResource HintText}" Text="Beispiele / Hinweise" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Folders}"
                             ItemTemplate="{StaticResource FolderRowTemplate}"
                             ItemContainerStyle="{StaticResource PlainRowContainerStyle}"
                             MaxHeight="400"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="FlattenFolders" />
                </StackPanel>
            </ui:Card>

            <!-- Aktionen -->
            <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Vorschau" Icon="{ui:SymbolIcon Eye24}" Command="{Binding PreviewCommand}" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" Appearance="Primary" Content="Ausführen" Icon="{ui:SymbolIcon FolderArrowRight24}"
                                   Command="{Binding ExecuteCommand}" Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="FlattenExecute" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}" Height="6" />
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ProgressText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="3" Content="Rückgängig (letzter Lauf)" Icon="{ui:SymbolIcon ArrowUndo24}"
                                   ToolTip="{Binding LastRunText}" Command="{Binding UndoCommand}" Margin="16,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding LastRunText}" Margin="0,8,0,0"
                               Visibility="{Binding LastRunText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ui:Card>

            <!-- Plan-Vorschau -->
            <ui:Card Margin="0,0,0,8" Padding="12" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Vorschau: Quelle → Ziel" />
                    <TextBlock Text="{Binding PlanSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <ui:InfoBar Severity="Error"
                                IsClosable="False"
                                Title="Ziel gesperrt"
                                Message="{Binding PlanTargetError}"
                                IsOpen="{Binding PlanTargetBlocked, Mode=OneWay}"
                                Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding PlanRows}"
                             ItemTemplate="{StaticResource PlanRowTemplate}"
                             ItemContainerStyle="{StaticResource PlainRowContainerStyle}"
                             MaxHeight="360"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </ui:Card>

            <!-- Status -->
            <Border Padding="10,6" CornerRadius="4" Background="{DynamicResource LayerFillColorAltBrush}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

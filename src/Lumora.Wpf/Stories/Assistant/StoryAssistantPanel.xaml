<UserControl x:Class="Lumora.Stories.Assistant.StoryAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:stories="clr-namespace:Lumora.Stories"
             xmlns:local="clr-namespace:Lumora.Stories.Assistant"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:StoryAssistantViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1000">
    <!-- Story-Assistent (Mockup 12, ADR-0063): Eingabeleiste, Fortschritt, „So habe ich es verstanden“, Rückfrage,
         „Zuletzt gefragt“. DataContext = StoryAssistantViewModel; jeder Punkt der Karte öffnet beim Klick sein Menü. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../StoriesResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AssistantCardBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>

            <!-- Wert der Karte (Mockup: Token mit Stift) -->
            <Style x:Key="TokenButton" TargetType="local:AssistantMenuButton">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:AssistantMenuButton">
                            <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TokenTemplate" DataType="{x:Type local:AssistantToken}">
                <local:AssistantMenuButton Style="{StaticResource TokenButton}" AutomationProperties.Name="{Binding AutomationText}"
                                           ToolTip="Ändern">
                    <local:AssistantMenuButton.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Options}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Text}" />
                                    <Setter Property="Command" Value="{Binding ApplyCommand}" />
                                    <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </local:AssistantMenuButton.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" Margin="0,0,6,0" Visibility="{Binding IsPerson, Converter={StaticResource BoolToVis}}">
                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <stories:StoryImage Source="{Binding Image}" CornerRadius="9" />
                        </Grid>
                        <ui:SymbolIcon Symbol="Warning16" FontSize="12" Margin="0,0,5,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding IsWarning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Detail, StringFormat=' · {0}'}" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                        <ui:SymbolIcon Symbol="Edit16" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </local:AssistantMenuButton>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
        <!-- Eingabeleiste -->
        <Border CornerRadius="10" Padding="14,12" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B5FC7" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="0.6" />
                                <GradientStop Color="#F97362" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ui:TextBox x:Name="SentenceBox" Grid.Column="1"
                                PlaceholderText="Was möchten Sie sehen? z. B. „Collage mit meiner Schwester aus meiner Kindheit bis 20 Jahre“"
                                Text="{Binding Sentence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="AssistantSentence"
                                AutomationProperties.Name="Satz für den Story-Assistenten"
                                IsEnabled="{Binding IsIdle}"
                                KeyDown="OnSentenceKeyDown" />
                    <ui:Button Grid.Column="2" Margin="10,0,0,0" Appearance="Primary" Content="Los" Icon="{ui:SymbolIcon ArrowRight24}"
                               AutomationProperties.AutomationId="AssistantAsk"
                               Command="{Binding AskCommand}" IsEnabled="{Binding IsIdle}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Examples}" Margin="42,8,0,0" Focusable="False"
                              Visibility="{Binding ShowExamples, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,4" Padding="10,3" Cursor="Hand" Content="{Binding}" FontSize="12"
                                    AutomationProperties.Name="{Binding}"
                                    Command="{Binding DataContext.UseExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="13" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <ContentPresenter TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="42,4,0,0">
                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="AssistantLocalHint"
                               Text="Läuft nur auf diesem PC. Die Sprach-KI liest nur Ihren Satz, nie Ihre Fotos — sie übersetzt ihn in Filter, Lumora sucht die Fotos." />
                </StackPanel>

                <!-- Fortschritt (abbrechbar) -->
                <StackPanel Orientation="Horizontal" Margin="42,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" FontSize="13" />
                    <ui:Button Margin="12,0,0,0" Content="Abbrechen" Appearance="Transparent" Command="{Binding CancelAskCommand}"
                               AutomationProperties.AutomationId="AssistantCancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hinweise -->
        <ui:InfoBar Margin="0,10,0,0" Severity="Informational" IsClosable="False" Message="{Binding SetupHint}"
                    IsOpen="{Binding SetupHint, Converter={StaticResource NullToBool}, Mode=OneWay}"
                    Visibility="{Binding SetupHint, Converter={StaticResource NullToVis}}"
                    AutomationProperties.AutomationId="AssistantSetupHint">
            <ui:InfoBar.Content>
                <ui:Button Content="Einstellungen › Assistent" Command="{Binding OpenSettingsCommand}" />
            </ui:InfoBar.Content>
        </ui:InfoBar>
        <ui:InfoBar Margin="0,10,0,0" Severity="Error" IsClosable="False" Message="{Binding ErrorText}"
                    IsOpen="{Binding ErrorText, Converter={StaticResource NullToBool}, Mode=OneWay}"
                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
        <ui:InfoBar Margin="0,10,0,0" Severity="Success" IsClosable="False" Message="{Binding StatusText}"
                    IsOpen="{Binding StatusText, Converter={StaticResource NullToBool}, Mode=OneWay}"
                    Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                    AutomationProperties.AutomationId="AssistantStatus" />

        <!-- So habe ich es verstanden -->
        <Grid Visibility="{Binding Card, Converter={StaticResource NullToVis}}" AutomationProperties.AutomationId="AssistantCard">
            <Border Style="{StaticResource AssistantCardBorder}" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.08" BorderThickness="0" />
            <Border Style="{StaticResource AssistantCardBorder}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="Transparent">
                <StackPanel DataContext="{Binding Card}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="So habe ich es verstanden — stimmt das?" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AssistantFact}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tokens}" ItemTemplate="{StaticResource TokenTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding CountText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                   AutomationProperties.AutomationId="AssistantCount" />
                        <TextBlock Text="{Binding ResultText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Preview}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AssistantPreviewImage}">
                                    <Grid Width="46" Height="46" Margin="0,0,4,0">
                                        <Border CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <stories:StoryImage Source="{Binding Image}" CornerRadius="4" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="{Binding CreateText}" Margin="0,0,8,0"
                                   AutomationProperties.AutomationId="AssistantCreate"
                                   IsEnabled="{Binding CanCreate}"
                                   Command="{Binding DataContext.CreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ui:Button Icon="{ui:SymbolIcon Image24}" Content="Nur Fotos zeigen (Galerie)" Margin="0,0,8,0"
                                   IsEnabled="{Binding CanCreate}"
                                   Command="{Binding DataContext.ShowGalleryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="Satz ändern" Margin="0,0,8,0"
                                   Command="{Binding DataContext.EditSentenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ui:Button Content="Abbrechen"
                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rückfrage -->
        <Border Style="{StaticResource AssistantCardBorder}" Visibility="{Binding Question, Converter={StaticResource NullToVis}}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                AutomationProperties.AutomationId="AssistantQuestion">
            <StackPanel DataContext="{Binding Question}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                </StackPanel>
                <TextBlock Text="{Binding Text}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AssistantChoice}">
                            <Button Margin="0,0,10,8" Padding="10,8" Cursor="Hand" Command="{Binding ChooseCommand}"
                                    AutomationProperties.Name="{Binding Label}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="36" Height="36" Margin="0,0,10,0" Visibility="{Binding HasFace, Converter={StaticResource BoolToVis}}">
                                        <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <ui:SymbolIcon Symbol="Person24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <stories:StoryImage Source="{Binding Image}" CornerRadius="18" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                <ui:Button Margin="0,8,0,0" Content="Abbrechen"
                           Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </Border>

        <!-- Zuletzt gefragt -->
        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="AssistantHistory">
            <TextBlock Text="Zuletzt gefragt" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AssistantHistoryRow}">
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="History16" FontSize="12" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Sentence, StringFormat='„{0}“'}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Grid.Column="2" Margin="10,0,6,0" Content="{Binding ActionText}"
                                           Command="{Binding Owner.OpenHistoryCommand}" CommandParameter="{Binding}" />
                                <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Aus dem Verlauf löschen"
                                           AutomationProperties.Name="Aus dem Verlauf löschen"
                                           Command="{Binding Owner.DeleteHistoryCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>

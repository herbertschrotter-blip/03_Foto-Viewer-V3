<dialogs:AppFluentWindow xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
        x:Class="PhotoViewerV3.Folders.Adoption.FolderAdoptionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
                 xmlns:target="clr-namespace:PhotoViewerV3.Gallery.ArchiveTarget"
                 xmlns:local="clr-namespace:PhotoViewerV3.Folders.Adoption"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:FolderAdoptionViewModel}"
                 Width="1040"
                 Height="700"
                 MinWidth="760"
                 MinHeight="480"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- „Ordner in die Bibliothek übernehmen…“ (ADR-0034): links der Zielordner-Baum des Bibliotheksordners (wie
         „In die Bibliothek…“), rechts die Vorschau alt → neu und die Optionen. Enter = Übernehmen, Esc = Abbrechen. -->
    <ui:FluentWindow.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
        <shell:NullToBoolConverter x:Key="NullToBool" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <TextBlock Grid.Row="1"
                   Margin="24,4,24,10"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding SourceText}" />

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Links: Zielordner im Bibliotheksordner -->
            <Grid Grid.Column="0" DataContext="{Binding Target}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="Zielordner in der Bibliothek" />
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox"
                                Grid.Column="0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="Ordner suchen…"
                                ClearButtonEnabled="True"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1"
                               Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon FolderAdd24}"
                               ToolTip="Neuer Ordner im gewählten Ordner"
                               Command="{Binding CreateFolderCommand}" />
                </Grid>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <TreeView x:Name="FolderTree"
                                  AutomationProperties.AutomationId="AdoptionFolderTree"
                                  ItemsSource="{Binding Roots}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type target:ArchiveFolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                        <ui:SymbolIcon Symbol="Folder16" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                                 SelectionChanged="OnSearchHitSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type target:ArchiveFolderNode}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                        <ui:SymbolIcon Symbol="Folder16" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3"
                           Margin="0,6,0,0"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TargetPath}"
                           Text="{Binding TargetDisplay}" />
            </Grid>

            <!-- Rechts: Vorschau + Optionen -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Vorschau: so entsteht der Ordner in der Bibliothek" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding PreviewSummary}"
                               Visibility="{Binding PreviewSummary, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <ListBox ItemsSource="{Binding PreviewRows}"
                                 AutomationProperties.AutomationId="AdoptionPreview"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Focusable="False"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AdoptionPreviewRow}">
                                    <Grid Margin="{Binding Indent, Converter={x:Static local:IndentToMarginConverter.Instance}}" ToolTip="{Binding RelativeTarget}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder16" FontSize="14" Margin="0,2,6,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Margin="12,0,4,0" FontSize="12" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding IsComputing, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <ui:InfoBar Grid.Row="2"
                            Severity="Warning"
                            IsClosable="False"
                            Margin="0,8,0,0"
                            Message="{Binding PreviewError}"
                            IsOpen="{Binding PreviewError, Converter={StaticResource NullToBool}, Mode=OneWay}"
                            Visibility="{Binding PreviewError, Converter={StaticResource NullToVis}}" />
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <CheckBox Content="Leere Zwischenordner zusammenziehen (z. B. Fotos\leer\leer\inhalt → Fotos\inhalt)"
                              IsChecked="{Binding CollapseEmptyChains}" />
                    <CheckBox Margin="0,4,0,0"
                              Content="Quellordner danach in den Papierkorb"
                              IsChecked="{Binding RecycleSource}" />
                    <TextBlock Margin="28,0,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding RecycleHint}" />
                    <CheckBox Margin="0,4,0,0"
                              Content="{Binding UnregisterText}"
                              IsChecked="{Binding UnregisterInbox}"
                              Visibility="{Binding IsWholeInbox, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Bewertungen, Tags, Kategorien und Vorschaubilder wandern mit. Rückgängig ist über „Rückgängig“ in der Galerie möglich." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button MinWidth="140"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Content="Übernehmen"
                               Icon="{ui:SymbolIcon FolderArrowRight24}"
                               IsEnabled="{Binding CanConfirm}"
                               Click="OnPrimaryClick" />
                    <ui:Button MinWidth="110"
                               Content="Abbrechen"
                               Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

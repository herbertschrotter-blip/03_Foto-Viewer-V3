<UserControl x:Class="PhotoViewerV3.Folders.FolderTreePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
             xmlns:local="clr-namespace:PhotoViewerV3.Folders"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FolderTreeViewModel}"
             d:DesignWidth="1100"
             d:DesignHeight="700">
    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
        <shell:NullToBoolConverter x:Key="NullToBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Links: Ordnerbaum -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,12,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="Ordner" />
                        <TextBlock Text="{Binding LibraryName}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- „Eingang hinzufügen…“ direkt hier (ADR-0042), gleicher Ablauf wie in Einstellungen › Bibliotheken & Eingänge -->
                    <ui:Button Grid.Column="1"
                               Content="Eingang hinzufügen…"
                               Icon="{ui:SymbolIcon MailInbox24}"
                               Padding="8,4"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="Unsortierten Quellordner als Eingang der aktiven Bibliothek aufnehmen — Dateien darin erscheinen im Filter „Noch im Eingang“"
                               Command="{Binding AddInboxCommand}"
                               Visibility="{Binding CanShowAddInbox, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.Name="Eingang hinzufügen" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0"
                               Content="Gesamte Bibliothek"
                               Icon="{ui:SymbolIcon Library16}"
                               HorizontalAlignment="Stretch"
                               Command="{Binding SelectWholeLibraryCommand}" />
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon ArrowSync16}"
                               ToolTip="Ordnerbaum neu laden"
                               Margin="6,0,0,0"
                               Command="{Binding RefreshCommand}" />
                </Grid>

                <CheckBox Grid.Row="2"
                          Content="Unterordner einschließen"
                          IsChecked="{Binding IncludeSubfolders}"
                          Margin="4,0,0,6" />

                <StackPanel Grid.Row="3">
                    <ui:InfoBar Message="{Binding HintText}"
                                Severity="Warning"
                                IsClosable="False"
                                IsOpen="{Binding HintText, Converter={StaticResource NullToBool}, Mode=OneWay}"
                                Visibility="{Binding HintText, Converter={StaticResource NullToVis}}"
                                Margin="0,0,0,6" />
                    <!-- Ergebnis der letzten Ordner-Aktion (ADR-0034), mit ✕ ausblendbar -->
                    <Border Margin="0,0,0,6"
                            Padding="10,8,4,8"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="12" />
                            <ui:Button Grid.Column="1"
                                       Appearance="Transparent"
                                       Padding="4"
                                       VerticalAlignment="Top"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       ToolTip="Ausblenden"
                                       Command="{Binding DismissResultCommand}" />
                        </Grid>
                    </Border>
                    <ui:InfoBar Message="{Binding ErrorMessage}"
                                Severity="Error"
                                IsClosable="False"
                                IsOpen="{Binding ErrorMessage, Converter={StaticResource NullToBool}, Mode=OneWay}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}"
                                Margin="0,0,0,6" />
                </StackPanel>

                <Grid Grid.Row="4">
                    <TreeView ItemsSource="{Binding Roots}"
                              BorderThickness="0"
                              Background="Transparent"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <!-- ViewModel für das Kontextmenü (liegt außerhalb des visuellen Baums) -->
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Neuer Ordner…"
                                                      Icon="{ui:SymbolIcon FolderAdd24}"
                                                      Command="{Binding PlacementTarget.Tag.CreateSubfolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Umbenennen…"
                                                      Icon="{ui:SymbolIcon Rename24}"
                                                      IsEnabled="{Binding CanRename}"
                                                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <!-- ADR-0034: Ordner aus dem Eingang in die Bibliothek übernehmen; Ordner bewerten/kategorisieren -->
                                            <Separator Visibility="{Binding IsInInbox, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="In die Bibliothek übernehmen…"
                                                      Icon="{ui:SymbolIcon FolderArrowRight24}"
                                                      ToolTip="Ordner samt Unterordner-Struktur in den Bibliotheksordner verschieben (leere Zwischenordner werden zusammengezogen)"
                                                      Visibility="{Binding IsInInbox, Converter={StaticResource BoolToVis}}"
                                                      Command="{Binding PlacementTarget.Tag.AdoptFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Bewertung für alle Dateien" Icon="{ui:SymbolIcon Star24}">
                                                <MenuItem Header="★ 1 Stern" Command="{Binding RateAllCommand}" CommandParameter="1" />
                                                <MenuItem Header="★★ 2 Sterne" Command="{Binding RateAllCommand}" CommandParameter="2" />
                                                <MenuItem Header="★★★ 3 Sterne" Command="{Binding RateAllCommand}" CommandParameter="3" />
                                                <MenuItem Header="★★★★ 4 Sterne" Command="{Binding RateAllCommand}" CommandParameter="4" />
                                                <MenuItem Header="★★★★★ 5 Sterne" Command="{Binding RateAllCommand}" CommandParameter="5" />
                                                <Separator />
                                                <MenuItem Header="Bewertung entfernen" Command="{Binding RateAllCommand}" CommandParameter="0" />
                                            </MenuItem>
                                            <MenuItem Header="Favorit für alle" Icon="{ui:SymbolIcon Heart24}">
                                                <MenuItem Header="Als Favorit markieren" Command="{Binding FavoriteAllCommand}" CommandParameter="true" />
                                                <MenuItem Header="Favorit entfernen" Command="{Binding FavoriteAllCommand}" CommandParameter="false" />
                                            </MenuItem>
                                            <MenuItem Header="Kategorie für alle…"
                                                      Icon="{ui:SymbolIcon Grid24}"
                                                      Command="{Binding PlacementTarget.Tag.EditFolderCategoriesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Tags für alle…"
                                                      Icon="{ui:SymbolIcon Tag24}"
                                                      Command="{Binding PlacementTarget.Tag.EditFolderTagsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <!-- ADR-0046: Aufnahmedatum für alle Dateien (im Dialog wahlweise mit Unterordnern) -->
                                            <MenuItem Header="Datum setzen…"
                                                      Icon="{ui:SymbolIcon CalendarEdit24}"
                                                      Command="{Binding PlacementTarget.Tag.SetFolderCaptureDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                    <ui:SymbolIcon Symbol="Folder16"
                                                   FontSize="14"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <!-- Rolle der Wurzel (ADR-0020) -->
                                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="8" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                            Visibility="{Binding RoleLabel, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding FileCount, StringFormat=N0}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IncludeSubfolders, RelativeSource={RelativeSource AncestorType={x:Type local:FolderTreePage}}}" Value="True">
                                                        <Setter Property="Text" Value="{Binding TotalFileCount, StringFormat=N0}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="28" Height="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,24,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <TextBlock Grid.Row="5"
                           Text="{Binding SelectionText}"
                           FontSize="11"
                           Margin="4,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectionText}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- Rechts: Galerie (eigene GalleryView-Instanz, ViewModel ist Singleton) -->
        <ContentControl Grid.Column="1" x:Name="GalleryHost" />
    </Grid>
</UserControl>

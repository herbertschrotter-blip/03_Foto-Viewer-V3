<UserControl x:Class="PhotoViewerV3.Sorter.Views.SorterLocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PhotoViewerV3.Sorter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SorterRootSelection, IsDesignTimeCreatable=False}"
             d:DesignWidth="900"
             Focusable="False">
    <!-- Quelle und Ziel über die Wurzeln der Bibliothek (ADR-0020/ADR-0024); DataContext = SorterRootSelection -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Eintrag: Rolle als Badge, Name, darunter Pfad; Offline-Wurzeln ausgegraut und nicht wählbar -->
        <DataTemplate x:Key="RootOptionTemplate" DataType="{x:Type vm:SorterRootOption}">
            <Grid x:Name="Item">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge"
                        Grid.Column="0"
                        CornerRadius="3"
                        Padding="6,1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding RoleText}" FontSize="11" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsArchive}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Item" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RootOptionContainerStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="ToolTip" Value="{Binding Detail}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Quelle -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Quelle:" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding SourceRoots}"
                  SelectedItem="{Binding SelectedSourceRoot}"
                  ItemTemplate="{StaticResource RootOptionTemplate}"
                  ItemContainerStyle="{StaticResource RootOptionContainerStyle}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip="Wurzel der Bibliothek (Eingang oder Archiv), aus der sortiert wird"
                  AutomationProperties.Name="Quell-Wurzel"
                  Margin="0,0,8,0" />
        <ui:TextBox Grid.Row="0" Grid.Column="2"
                    Icon="{ui:SymbolIcon Folder24}"
                    PlaceholderText="Wurzel oder Ordner darunter"
                    Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsEnabled}"
                    AutomationProperties.Name="Quellordner" />
        <ui:Button Grid.Row="0" Grid.Column="3" Content="Wählen…" Icon="{ui:SymbolIcon FolderOpen24}"
                   Command="{Binding PickSourceFolderCommand}" Margin="8,0,0,0" />

        <!-- Ziel -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ziel:" VerticalAlignment="Center" Margin="0,8,0,0" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding TargetRoots}"
                  SelectedItem="{Binding SelectedTargetRoot}"
                  ItemTemplate="{StaticResource RootOptionTemplate}"
                  ItemContainerStyle="{StaticResource RootOptionContainerStyle}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip="Wurzel, unter der die neuen Ordner entstehen (Standard: Archiv)"
                  AutomationProperties.Name="Ziel-Wurzel"
                  Margin="0,8,8,0" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TargetFolderDisplay}" VerticalAlignment="Center" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetRootDisplay}" />
        <ui:Button Grid.Row="1" Grid.Column="3" Content="Ordner wählen…" Icon="{ui:SymbolIcon FolderArrowRight24}"
                   ToolTip="Ordner unter einer Wurzel als Zielwurzel wählen (Ziele außerhalb der Bibliothek sind gesperrt)"
                   Command="{Binding PickTargetRootCommand}" Margin="8,8,0,0" />

        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0" Text="{Binding TargetHint}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTargetBlocked}" Value="True">
                            <Setter Property="Foreground" Value="#FF6B6B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

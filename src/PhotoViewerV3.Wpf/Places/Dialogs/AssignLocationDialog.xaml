<dialogs:AppFluentWindow x:Class="PhotoViewerV3.Places.Dialogs.AssignLocationDialog"
                 xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- „Hier verorten?“ (ADR-0051): Anzahl, Ortsname (GeoNames, offline), Koordinaten, Änderungsdatum beibehalten -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="Fotos verorten" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:SymbolIcon Symbol="Location24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel>
                    <TextBlock x:Name="PlaceText" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock x:Name="CoordinatesText" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <CheckBox x:Name="KeepModifiedBox" Margin="0,16,0,0" IsChecked="True"
                      Content="Änderungsdatum der Dateien beibehalten" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Die Koordinaten werden in den Katalog und in die Dateien (EXIF/XMP) geschrieben und lassen sich in der Galerie rückgängig machen." />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="OkButton" MinWidth="110" Margin="0,0,8,0" Appearance="Primary"
                           Content="Verorten" Click="OnOkClick" />
                <ui:Button MinWidth="110" Content="Abbrechen" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

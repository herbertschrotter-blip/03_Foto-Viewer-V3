<dialogs:AppFluentWindow x:Class="PhotoViewerV3.Places.Picker.MapPickerWindow"
                 xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:map="clr-namespace:PhotoViewerV3.Places.Map"
                 Width="760"
                 Height="560"
                 MinWidth="480"
                 MinHeight="380"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- „Ort wählen“ (IMapPicker, ADR-0051): kleine Karte, Klick setzt die Nadel, Ortssuche, Übernehmen -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="Ort wählen" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Auf die Karte klicken, um den Ort zu setzen. Mausrad zoomt, Ziehen verschiebt." />
            <ui:TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Ort suchen …" Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.Name="Ort suchen" KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Width="260" Margin="0,4,0,0" Padding="4" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <ListBox x:Name="SearchList" BorderThickness="0" Background="Transparent" MaxHeight="280"
                             DisplayMemberPath="Display" PreviewMouseLeftButtonUp="OnSearchResultClick" />
                </Border>
            </Popup>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ClipToBounds="True">
                <map:MapControl x:Name="Map"
                                AutomationProperties.Name="Karte"
                                MapBackground="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BadgeForeground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                PlaceholderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <Border Padding="6,2" CornerRadius="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Opacity="0.9">
                    <TextBlock x:Name="AttributionText" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="16,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="OkButton" MinWidth="110" Margin="0,0,8,0" Appearance="Primary" Content="Übernehmen"
                               IsEnabled="False" Click="OnOkClick" />
                    <ui:Button MinWidth="110" Content="Abbrechen" Click="OnCancelClick" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceText" Text="Noch kein Ort gewählt" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CoordinatesText" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

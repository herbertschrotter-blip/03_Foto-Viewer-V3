<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoViewerV3</RootNamespace>
    <AssemblyName>PhotoViewerV3</AssemblyName>
    <!-- App-Version (Einstellungen → „Über“, Datei-/Produktversion der EXE) = oberster Eintrag „## [x.y.z]“ in
         CHANGELOG.md, der Versionsquelle des Commit-Profils; so muss sie nicht je Commit nachgezogen werden.
         Ohne Git-Revisions-Suffix. build/publish.ps1 prüft, dass die veröffentlichte EXE dieselbe Version trägt. -->
    <ChangelogFile>$(MSBuildThisFileDirectory)..\..\CHANGELOG.md</ChangelogFile>
    <Version Condition="Exists('$(ChangelogFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ChangelogFile)')), '(?m)(?&lt;=^## \[)\d+\.\d+\.\d+(?=\])').Value)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoViewerV3.Wpf.Tests" />
  </ItemGroup>

  <!-- Einstellungen › Info → „Änderungsprotokoll“ (ADR-0042): CHANGELOG.md neben die EXE (Debug-Ausgabe und portables Paket) -->
  <ItemGroup>
    <None Include="$(ChangelogFile)" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoViewerV3.Domain\PhotoViewerV3.Domain.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Data\PhotoViewerV3.Data.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Services\PhotoViewerV3.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>

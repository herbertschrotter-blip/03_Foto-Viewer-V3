<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoViewerV3</RootNamespace>
    <!-- Produktname „Lumora“ seit 0.2.49 (ADR-0047): Programmdatei Lumora.exe, Produkt/Titel/Dateibeschreibung „Lumora“.
         Projekt- und Namespace-Namen PhotoViewerV3.* bleiben; XAML verweist daher nie per „/PhotoViewerV3;component/…“
         auf eigene Ressourcen, sondern relativ (LumoraBrandingTests wacht darüber). -->
    <AssemblyName>Lumora</AssemblyName>
    <Product>Lumora</Product>
    <AssemblyTitle>Lumora</AssemblyTitle>
    <ApplicationIcon Condition="Exists('Shell\Branding\Lumora.ico')">Shell\Branding\Lumora.ico</ApplicationIcon>
    <!-- App-Version (Einstellungen → „Über“, Datei-/Produktversion der EXE) = oberster Eintrag „## [x.y.z]“ in
         CHANGELOG.md, der Versionsquelle des Commit-Profils; so muss sie nicht je Commit nachgezogen werden.
         Ohne Git-Revisions-Suffix. build/publish.ps1 prüft, dass die veröffentlichte EXE dieselbe Version trägt. -->
    <ChangelogFile>$(MSBuildThisFileDirectory)..\..\CHANGELOG.md</ChangelogFile>
    <Version Condition="Exists('$(ChangelogFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ChangelogFile)')), '(?m)(?&lt;=^## \[)\d+\.\d+\.\d+(?=\])').Value)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoViewerV3.Wpf.Tests" />
  </ItemGroup>

  <!-- Einstellungen › Info → „Änderungsprotokoll“ (ADR-0042): CHANGELOG.md neben die EXE (Debug-Ausgabe und portables Paket) -->
  <ItemGroup>
    <None Include="$(ChangelogFile)" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- App-Symbol (ADR-0047): Lumora.ico wird mit build/make-icon.ps1 aus Shell/Branding/LumoraIcon.xaml erzeugt und
       eingecheckt; eingebettet für Window.Icon (LumoraAppIcon). -->
  <ItemGroup Condition="Exists('Shell\Branding\Lumora.ico')">
    <EmbeddedResource Include="Shell\Branding\Lumora.ico" LogicalName="Lumora.ico" />
  </ItemGroup>

  <!-- Bis 0.2.48 hieß die Programmdatei PhotoViewerV3.exe: veraltete Reste im Ausgabeordner entfernen, damit keine
       Verknüpfung versehentlich die alte Version startet. Gesperrte Dateien (laufende alte App) bleiben liegen. -->
  <Target Name="RemoveFormerPhotoViewerV3Output" AfterTargets="Build">
    <ItemGroup>
      <_FormerAppFile Include="$(OutDir)PhotoViewerV3.exe;$(OutDir)PhotoViewerV3.dll;$(OutDir)PhotoViewerV3.pdb;$(OutDir)PhotoViewerV3.deps.json;$(OutDir)PhotoViewerV3.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(_FormerAppFile)" Condition="Exists('%(_FormerAppFile.Identity)')" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PhotoViewerV3.Domain\PhotoViewerV3.Domain.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Data\PhotoViewerV3.Data.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Services\PhotoViewerV3.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>

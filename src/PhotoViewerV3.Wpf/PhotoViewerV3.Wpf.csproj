<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoViewerV3</RootNamespace>
    <AssemblyName>PhotoViewerV3</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoViewerV3.Domain\PhotoViewerV3.Domain.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Data\PhotoViewerV3.Data.csproj" />
    <ProjectReference Include="..\PhotoViewerV3.Services\PhotoViewerV3.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

</Project>

<dialogs:AppFluentWindow x:Class="PhotoViewerV3.Libraries.Linking.LibraryLinkDialog"
                 xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
                 xmlns:local="clr-namespace:PhotoViewerV3.Libraries.Linking"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:LibraryLinkDialogViewModel}"
                 Title="{Binding Title}"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">
    <!-- „Verknüpfen mit…“ (ADR-0048): Partner wählen, Vorschau (Zusammenfassung), gleichnamige Personen einzeln
         zusammenführen (Standard) oder getrennt halten. Feste Breite, Höhe aus dem Inhalt (keine Wpf.Ui MessageBox). -->
    <dialogs:AppFluentWindow.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
    </dialogs:AppFluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Verknüpfen mit" Margin="0,14,0,4" FontWeight="SemiBold" />
            <ComboBox x:Name="CandidateBox"
                      ItemsSource="{Binding Candidates}"
                      SelectedItem="{Binding SelectedCandidate}"
                      DisplayMemberPath="Name"
                      AutomationProperties.Name="Bibliothek zum Verknüpfen" />
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasPersonChoices, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Gleichnamige Personen zusammenführen" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PersonChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LibraryLinkPersonChoice}">
                                <CheckBox IsChecked="{Binding Merge}" Content="{Binding Name}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ConfirmButton"
                           Content="Verknüpfen"
                           MinWidth="110"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           IsEnabled="{Binding CanConfirm}"
                           Click="OnConfirmClick" />
                <ui:Button Content="Abbrechen" MinWidth="110" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

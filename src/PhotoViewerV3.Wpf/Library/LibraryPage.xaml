<UserControl x:Class="PhotoViewerV3.Libraries.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
             xmlns:local="clr-namespace:PhotoViewerV3.Libraries"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LibraryViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="Bibliotheken" />
                <ui:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Jede Bibliothek entspricht einem Foto-Ordner. Galerie und Ordnerbaum zeigen die aktive Bibliothek." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Aktualisieren"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding LoadCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Neue Bibliothek…"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           Appearance="Primary"
                           Command="{Binding CreateLibraryCommand}" />
            </StackPanel>
        </Grid>

        <!-- Fehler -->
        <ui:InfoBar Grid.Row="1"
                    Title="Fehler"
                    Message="{Binding ErrorMessage}"
                    Severity="Error"
                    IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                    Margin="0,0,0,12" />

        <!-- Scan-Panel: laufender Scan bzw. Zusammenfassung -->
        <Border Grid.Row="2"
                Visibility="{Binding IsScanPanelVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <!-- Laufender Scan -->
                <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="28" Height="28"
                                     VerticalAlignment="Top"
                                     Margin="0,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold"><Run Text="Scanne „" /><Run Text="{Binding ScanLibraryName, Mode=OneWay}" /><Run Text="“ — " /><Run Text="{Binding ScanPhaseText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="{Binding ScanFolders, Mode=OneWay, StringFormat=N0}" /><Run Text=" Ordner · " /><Run Text="{Binding ScanFiles, Mode=OneWay, StringFormat=N0}" /><Run Text=" Dateien · " /><Run Text="{Binding ScanSizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ScanElapsedText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding ScanCurrentPath}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Content="Abbrechen"
                               Icon="{ui:SymbolIcon Stop24}"
                               Command="{Binding CancelScanCommand}"
                               VerticalAlignment="Top"
                               Margin="16,0,0,0" />
                </Grid>

                <!-- Zusammenfassung nach dem Scan -->
                <Grid Visibility="{Binding IsScanSummaryOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="24"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource InvBoolToVis}}" />
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Warning24"
                                   FontSize="24"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ScanSummaryTitle}" />
                        <TextBlock Text="{Binding ScanSummary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Content="Zur Galerie"
                               Icon="{ui:SymbolIcon Image24}"
                               Command="{Binding GoToGalleryCommand}"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource InvBoolToVis}}" />
                    <ui:Button Grid.Column="3"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Appearance="Transparent"
                               ToolTip="Ausblenden"
                               Command="{Binding DismissScanSummaryCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Liste -->
        <Grid Grid.Row="3">
            <ui:ProgressRing IsIndeterminate="True"
                             Width="32" Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,32,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Leerzustand -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="440"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Library24"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:TextBlock FontTypography="Subtitle"
                              Text="Noch keine Bibliothek"
                              HorizontalAlignment="Center"
                              Margin="0,12,0,4" />
                <TextBlock TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Wähle mit „Neue Bibliothek…“ einen Foto-Ordner aus. Danach wird der Ordner durchsucht und der Katalog aufgebaut." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Libraries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LibraryListItem}">
                            <Border Margin="0,0,0,10"
                                    Padding="16,12"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Library24"
                                                   FontSize="28"
                                                   VerticalAlignment="Top"
                                                   Margin="0,2,16,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding IsRootAvailable, Converter={StaticResource InvBoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Warning16" FontSize="12" Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="Ordner nicht erreichbar" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RootPath}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding CountsText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimestampText, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ui:Button Content="{Binding ScanButtonText}"
                                                   Icon="{ui:SymbolIcon Scan24}"
                                                   Appearance="Primary"
                                                   IsEnabled="{Binding IsRootAvailable}"
                                                   Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Content="Aktiv setzen"
                                                   Icon="{ui:SymbolIcon Checkmark24}"
                                                   Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Icon="{ui:SymbolIcon Rename24}"
                                                   ToolTip="Umbenennen"
                                                   Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                   ToolTip="Aus dem Katalog entfernen (löscht keine Dateien auf der Festplatte)"
                                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

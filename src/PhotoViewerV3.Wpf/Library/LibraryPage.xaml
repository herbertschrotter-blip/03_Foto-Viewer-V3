<UserControl x:Class="PhotoViewerV3.Libraries.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
             xmlns:local="clr-namespace:PhotoViewerV3.Libraries"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LibraryViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <UserControl.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Seit 0.2.44 Reiter „Bibliotheken & Eingänge“ der Einstellungen (ADR-0042): Überschrift = Reiter, hier nur die Einleitung -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Woher die Fotos kommen und wohin sie verschoben werden." />
                <ui:TextBlock FontTypography="Caption"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Jede Bibliothek hat einen Bibliotheksordner (dein sortiertes Fotoarchiv) und beliebig viele Eingänge (unsortierte Quellordner). Galerie und Ordnerbaum zeigen die aktive Bibliothek. „Aktualisieren“ übernimmt Änderungen auf der Platte (alle Ordner), „Neu aufbauen“ erstellt den Katalog komplett neu." />
                <!-- ADR-0034: kurzer Ablauf + was die Datenbank ist -->
                <Border Margin="0,10,0,0"
                        Padding="12,8"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="So funktioniert's" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12"
                                   Text="1. Eingang hinzufügen (unsortierter Quellordner)  →  2. ansehen, bewerten, kategorisieren (einzelne Dateien oder per Rechtsklick ganze Ordner im Ordnerbaum)  →  3. Ordner in die Bibliothek übernehmen (Struktur bleibt, leere Zwischenordner werden zusammengezogen)." />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Die Datenbank (Katalog) enthält nur Verweise auf deine Dateien samt Bewertungen, Favoriten, Tags und Kategorien — keine Bilder. Die Fotos bleiben in ihren Ordnern auf der Festplatte." />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Liste neu laden"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding LoadCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Neue Bibliothek…"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           Appearance="Primary"
                           Command="{Binding CreateLibraryCommand}" />
            </StackPanel>
        </Grid>

        <!-- Fehler -->
        <ui:InfoBar Grid.Row="1"
                    Title="Fehler"
                    Message="{Binding ErrorMessage}"
                    Severity="Error"
                    IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                    Margin="0,0,0,12" />

        <!-- Scan-Panel: laufender Scan bzw. Zusammenfassung -->
        <Border Grid.Row="2"
                Visibility="{Binding IsScanPanelVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <!-- Laufender Scan -->
                <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="28" Height="28"
                                     VerticalAlignment="Top"
                                     Margin="0,2,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding ScanActionText, Mode=OneWay}" /><Run Text=" „" /><Run Text="{Binding ScanLibraryName, Mode=OneWay}" /><Run Text="“ — " /><Run Text="{Binding ScanPhaseText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="{Binding ScanFolders, Mode=OneWay, StringFormat=N0}" /><Run Text=" Ordner · " /><Run Text="{Binding ScanFiles, Mode=OneWay, StringFormat=N0}" /><Run Text=" Dateien · " /><Run Text="{Binding ScanSizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ScanElapsedText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding ScanCurrentPath}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Content="Abbrechen"
                               Icon="{ui:SymbolIcon Stop24}"
                               Command="{Binding CancelScanCommand}"
                               VerticalAlignment="Top"
                               Margin="16,0,0,0" />
                </Grid>

                <!-- Zusammenfassung nach dem Scan -->
                <Grid Visibility="{Binding IsScanSummaryOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="24"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource InvBoolToVis}}" />
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Warning24"
                                   FontSize="24"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ScanSummaryTitle}" />
                        <TextBlock Text="{Binding ScanSummary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Content="Zur Galerie"
                               Icon="{ui:SymbolIcon Image24}"
                               Command="{Binding GoToGalleryCommand}"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               Visibility="{Binding ScanSummaryIsWarning, Converter={StaticResource InvBoolToVis}}" />
                    <ui:Button Grid.Column="3"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Appearance="Transparent"
                               ToolTip="Ausblenden"
                               Command="{Binding DismissScanSummaryCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Liste -->
        <Grid Grid.Row="3">
            <ui:ProgressRing IsIndeterminate="True"
                             Width="32" Height="32"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,32,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Leerzustand -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="440"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Library24"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:TextBlock FontTypography="Subtitle"
                              Text="Noch keine Bibliothek"
                              HorizontalAlignment="Center"
                              Margin="0,12,0,4" />
                <TextBlock TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Wähle mit „Neue Bibliothek…“ einen Foto-Ordner aus. Danach wird der Ordner durchsucht und der Katalog aufgebaut." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Libraries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LibraryListItem}">
                            <Border Margin="0,0,0,10"
                                    Padding="16,12"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="Library24"
                                                   FontSize="28"
                                                   VerticalAlignment="Top"
                                                   Margin="0,2,16,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding HasOfflineRoot, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Warning16" FontSize="12" Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="Ordner nicht erreichbar" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding CountsText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RootsText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimestampText, Mode=OneWay}" /></TextBlock>

                                        <!-- Wurzeln (ADR-0020): Bibliotheksordner zuerst, dann Eingänge; je Zeile Rolle, Pfad, Erreichbarkeit, Aktionen -->
                                        <ItemsControl ItemsSource="{Binding Roots}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:LibraryRootListItem}">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" MinWidth="64" Padding="8,1" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding RoleText}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Path}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="520"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <ui:SymbolIcon Symbol="Warning16" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           ToolTip="Ordner nicht erreichbar"
                                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                           Visibility="{Binding IsAvailable, Converter={StaticResource InvBoolToVis}}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Archive24}" Padding="6,4"
                                                                       ToolTip="Diesen Ordner zum Bibliotheksordner machen (der bisherige Bibliotheksordner wird Eingang)"
                                                                       Visibility="{Binding CanMakeArchive, Converter={StaticResource BoolToVis}}"
                                                                       Command="{Binding DataContext.MakeArchiveRootCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon FolderArrowRight24}" Padding="6,4"
                                                                       Content="In die Bibliothek übernehmen…"
                                                                       ToolTip="Den ganzen Eingang samt Unterordner-Struktur in den Bibliotheksordner verschieben (Vorschau, leere Zwischenordner zusammenziehen, danach austragen)"
                                                                       Visibility="{Binding IsInbox, Converter={StaticResource BoolToVis}}"
                                                                       Command="{Binding DataContext.AdoptInboxCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Rename24}" Padding="6,4"
                                                                       ToolTip="Anzeigename der Wurzel ändern"
                                                                       Command="{Binding DataContext.RenameRootCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Padding="6,4"
                                                                       ToolTip="Eingang nur aus dem Katalog entfernen (löscht keine Dateien auf der Festplatte)"
                                                                       Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                                       Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ui:Button Content="Eingang hinzufügen…"
                                                   Icon="{ui:SymbolIcon MailInbox24}"
                                                   Appearance="Secondary"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,4,0,0"
                                                   ToolTip="Unsortierten Quellordner als Eingang aufnehmen — Dateien darin erscheinen im Filter „Noch im Eingang“"
                                                   Command="{Binding DataContext.AddInboxRootCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}" />

                                        <!-- Verknüpfung (ADR-0048): eigene Einstellung je Bibliothek; ausgeblendet in einer versteckten Bibliothek -->
                                        <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                Visibility="{Binding ShowLinking, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="Link24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding LinkText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <ui:Button Content="Verknüpfen mit…" Icon="{ui:SymbolIcon Link24}" Appearance="Secondary" Padding="8,4" Margin="0,0,6,0"
                                                               ToolTip="Mit einer anderen Bibliothek verknüpfen: Tags, Kategorien, Personen und Beziehungen werden gemeinsam, beide lassen sich unter „Alle verknüpften“ zusammen ansehen"
                                                               Visibility="{Binding CanLink, Converter={StaticResource BoolToVis}}"
                                                               Command="{Binding DataContext.LinkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Content="Verknüpfung lösen" Icon="{ui:SymbolIcon LinkDismiss24}" Appearance="Secondary" Padding="8,4" Margin="0,0,6,0"
                                                               ToolTip="Diese Bibliothek wieder einzeln führen — sie bekommt eine Kopie aller gemeinsamen Begriffe und Personen"
                                                               Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}"
                                                               Command="{Binding DataContext.UnlinkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Rename24}" Appearance="Transparent" Padding="6,4"
                                                               ToolTip="Gruppe umbenennen („Alle verknüpften (Name)“)"
                                                               Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}"
                                                               Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                        <!-- Primär: „Scannen“ (Fresh) bei leerem Katalog, sonst „Aktualisieren“ (Incremental).
                                             Bewusst auch bei nicht erreichbarem Ordner aktiv: der Scan meldet dann „Bibliothek offline“
                                             mit [Erneut prüfen] [Andere Bibliothek wählen] (PLAN Kap. 12). -->
                                        <ui:Button Content="{Binding ScanButtonText}"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Appearance="Primary"
                                                   ToolTip="{Binding ScanButtonToolTip}"
                                                   Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,8,0" />
                                        <!-- Sekundär: „Neu aufbauen“ (ClearAndRescan nach Bestätigung), nur bei vorhandenem Katalog -->
                                        <ui:Button Content="Neu aufbauen"
                                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                                   ToolTip="Katalog dieser Bibliothek komplett neu aufbauen — Favoriten, Bewertungen, Tags und Kategorien bleiben erhalten; bis zum Abschluss bleibt der bisherige Katalog bestehen"
                                                   Visibility="{Binding CanRebuild, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.RebuildCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Content="Aktiv setzen"
                                                   Icon="{ui:SymbolIcon Checkmark24}"
                                                   Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource InvBoolToVis}}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Icon="{ui:SymbolIcon Rename24}"
                                                   ToolTip="Umbenennen"
                                                   Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}"
                                                   Margin="0,0,8,0" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                   ToolTip="Aus dem Katalog entfernen (löscht keine Dateien auf der Festplatte)"
                                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Fußbereich unter der Liste (Einstellungen setzen hier die Ordnerüberwachung ein, ADR-0042) -->
                <ContentControl x:Name="FooterHost" Focusable="False"
                                Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource InvBoolToVis}}" />
              </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<ui:FluentWindow x:Class="PhotoViewerV3.Shell.Dialogs.AppDialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- Eigenes Dialogfenster statt Wpf.Ui MessageBox: feste Breite, Höhe aus dem Inhalt.
         Die MessageBox von WPF-UI 4.0.2 berechnet ihre Größe in OnLoaded selbst (ResizeToContentSize)
         und gerät mit umbrechendem Text plus Eingabefeld in eine Layout-Schleife (Hänger, Speicher wächst). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14" />
            <ui:TextBox x:Name="InputBox"
                        Margin="0,14,0,0"
                        Visibility="Collapsed" />
            <ScrollViewer x:Name="DetailsScroll"
                          Margin="0,12,0,0"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <TextBlock x:Name="DetailsText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ScrollViewer>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PrimaryButton"
                           MinWidth="110"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Visibility="Collapsed"
                           Click="OnPrimaryClick" />
                <ui:Button x:Name="SecondaryButton"
                           MinWidth="110"
                           Margin="0,0,8,0"
                           Visibility="Collapsed"
                           Click="OnSecondaryClick" />
                <ui:Button x:Name="CloseButton"
                           MinWidth="110"
                           Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

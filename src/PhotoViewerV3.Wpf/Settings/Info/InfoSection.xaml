<UserControl x:Class="PhotoViewerV3.Settings.Info.InfoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PhotoViewerV3.Settings.Info"
             xmlns:branding="clr-namespace:PhotoViewerV3.Shell.Branding"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:InfoViewModel}"
             d:DesignWidth="1000">
    <!-- Einstellungen › Info (ADR-0042, Mockup 06): Kopfkarte, dann Entwicklung / Dieses System / Speicherorte / Bausteine -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Sections/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="LinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <!-- Zeile „Bezeichnung  Wert“ einer Info-Karte -->
            <DataTemplate x:Key="InfoLineTemplate" DataType="{x:Type local:InfoLine}">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource SectionPanel}">
            <!-- Kopfkarte -->
            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Lumora-Kopf (ADR-0047, Mockup 07 „Einstellungen › Info“): großes Symbol + Schriftzug -->
                    <Image Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center"
                           Source="{x:Static branding:LumoraIconImages.Full}" AutomationProperties.Name="Lumora-Symbol" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <branding:LumoraWordmark x:Name="Wordmark" FontSize="30" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding HeaderText}" Margin="0,2,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="Version" />
                        <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Content="Versionsinfo kopieren" Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding CopyVersionInfoCommand}" />
                        <ui:Button Content="Änderungsprotokoll" Icon="{ui:SymbolIcon History24}" Margin="8,0,0,0"
                                   Command="{Binding OpenChangelogCommand}"
                                   Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Message}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Entwicklung -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Entwicklung" />
                        <ItemsControl ItemsSource="{Binding Development}" ItemTemplate="{StaticResource InfoLineTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Dieses System -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Dieses System" />
                        <ItemsControl ItemsSource="{Binding SystemInfo}" ItemTemplate="{StaticResource InfoLineTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Speicherorte -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Speicherorte" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Katalog" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabasePath}" ToolTip="{Binding DatabasePath}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Row="0" Grid.Column="2" Style="{StaticResource LinkButton}" Content="öffnen"
                                       Command="{Binding OpenDatabaseCommand}" AutomationProperties.Name="Katalog im Explorer öffnen" />
                            <TextBlock Grid.Row="1" Text="Vorschaubilder" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThumbnailsPath}" ToolTip="{Binding ThumbnailsPath}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Row="1" Grid.Column="2" Style="{StaticResource LinkButton}" Content="öffnen"
                                       Command="{Binding OpenThumbnailsCommand}" AutomationProperties.Name="Vorschaubilder im Explorer öffnen" />
                            <TextBlock Grid.Row="2" Text="Protokolle" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogsPath}" ToolTip="{Binding LogsPath}"
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Row="2" Grid.Column="2" Style="{StaticResource LinkButton}" Content="öffnen"
                                       Command="{Binding OpenLogsCommand}" AutomationProperties.Name="Protokolle im Explorer öffnen" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Verwendete Bausteine -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Verwendete Bausteine" />
                        <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource InfoLineTemplate}" Focusable="False" />
                        <ui:Button Style="{StaticResource LinkButton}" Margin="-6,4,0,0" HorizontalAlignment="Left"
                                   Content="Alle Lizenzen anzeigen…" Command="{Binding ShowLicensesCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

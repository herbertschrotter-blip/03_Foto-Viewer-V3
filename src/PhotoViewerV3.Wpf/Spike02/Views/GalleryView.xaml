<UserControl x:Class="PhotoViewerV3.Spike02.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:data="clr-namespace:PhotoViewerV3.Spike02.Data"
             xmlns:vm="clr-namespace:PhotoViewerV3.Spike02.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title / library badge -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:TextBlock FontTypography="Title" Text="Gallery" />
            <ui:TextBlock FontTypography="BodyStrong"
                          VerticalAlignment="Bottom"
                          Margin="16,0,0,4"
                          Text="{Binding LibraryNameDisplay}" />
        </StackPanel>

        <!-- Toolbar: Filter pills + search -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Content="Alle"        GroupName="Filter" IsChecked="True"
                             Command="{Binding SetFilterCommand}" CommandParameter="All"
                             Margin="0,0,8,0" />
                <RadioButton Content="Bilder"      GroupName="Filter"
                             Command="{Binding SetFilterCommand}" CommandParameter="Images"
                             Margin="0,0,8,0" />
                <RadioButton Content="Videos"      GroupName="Filter"
                             Command="{Binding SetFilterCommand}" CommandParameter="Videos"
                             Margin="0,0,8,0" />
                <RadioButton Content="Favoriten"   GroupName="Filter"
                             Command="{Binding SetFilterCommand}" CommandParameter="Favorites" />
            </StackPanel>

            <ui:TextBox Grid.Column="1"
                        PlaceholderText="FTS-Suche (z.B. Urlaub, IMG, Berge)…"
                        Margin="16,0,8,0"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Suchen"  Command="{Binding SearchCommand}"      Margin="0,0,4,0" />
                <ui:Button Content="Clear"   Command="{Binding ClearSearchCommand}" />
            </StackPanel>
        </Grid>

        <!-- Items: 500 Tiles per Page in WrapPanel -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ScrollViewer x:Name="GalleryScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <ItemsControl ItemsSource="{Binding CurrentPage}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="180" ItemHeight="160" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GalleryItem}">
                            <Border Margin="6"
                                    CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Media area: Thumbnail überlagert die Platzhalter-Icons, sobald geladen -->
                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <ui:SymbolIcon Symbol="Image24"
                                                       FontSize="48"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                        <Grid Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="Video24"
                                                           FontSize="48"
                                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Echtes Vorschaubild (null → Icons bleiben sichtbar) -->
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Favorite badge top right -->
                                        <TextBlock Text="&#x2665;"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#E66B6B"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,4,6,0"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <!-- Extension badge bottom right -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,6,4"
                                                Padding="6,1"
                                                CornerRadius="3"
                                                Background="{DynamicResource AccentFillColorTertiaryBrush}">
                                            <TextBlock Text="{Binding Extension}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Filename strip -->
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                            Padding="8,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Pager -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="⏮"  Command="{Binding FirstPageCommand}" Margin="0,0,4,0" />
                <ui:Button Content="◀"  Command="{Binding PrevPageCommand}"  Margin="0,0,8,0" />
                <ui:TextBlock VerticalAlignment="Center">
                    <Run Text="Seite " />
                    <Run Text="{Binding DisplayPageIndex, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" / " />
                    <Run Text="{Binding PageCount, StringFormat=N0, Mode=OneWay}" />
                </ui:TextBlock>
                <ui:Button Content="▶"  Command="{Binding NextPageCommand}"  Margin="8,0,4,0" />
                <ui:Button Content="⏭"  Command="{Binding LastPageCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="{Binding TotalCount, StringFormat='Total: {0:N0}'}" />
            </StackPanel>
        </Grid>

        <!-- Status / Telemetry -->
        <Border Grid.Row="4" Margin="0,8,0,0"
                Padding="10,6"
                Background="{DynamicResource LayerFillColorAltBrush}"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding FirstPageLoadMs, StringFormat='Start: {0:N0} ms'}"
                               FontSize="12"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding LastPageLoadMs, StringFormat='Letzte Page: {0:N1} ms'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error overlay -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Gallery konnte nicht geladen werden" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding DbPathDisplay, StringFormat='DB: {0}'}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PhotoViewerV3.Gallery.People.PersonFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:PhotoViewerV3.Gallery.Converters"
             xmlns:local="clr-namespace:PhotoViewerV3.Gallery.People"
             x:Name="Root"
             Focusable="False">
    <!--
        Personen-Filter (0.2.38) neben dem Tag-Filter: Knopf zeigt den aktiven Filter („Personen: Anna, Bert (UND)“), das
        Popup bietet je Person ein Häkchen (mit Zähler), die Verknüpfung ODER/UND/ohne Person/unbenannte Gesichter, die
        Option „auch Vorschläge“ und „Zurücksetzen“. Nur bestätigte Gesichter zählen als Person, solange „auch Vorschläge“
        aus ist. DataContext = GalleryViewModel (PersonFilterEntries, PersonFilterMode, PersonFilterIncludeSuggestions,
        ApplyPersonFilterCommand, ClearPersonFilterCommand).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      AutomationProperties.AutomationId="GalleryPersonFilterButton"
                      AutomationProperties.Name="Personen-Filter"
                      ToolTip="Nach Personen filtern"
                      Padding="10,4"
                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="People24" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{Binding PersonFilterText}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    MinWidth="280"
                    MaxHeight="460"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Verknüpfung" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <RadioButton Content="mindestens eine der Personen (ODER)" GroupName="PersonMode"
                                     IsChecked="{Binding PersonFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=Any}" />
                        <RadioButton Content="alle gewählten Personen (UND)" GroupName="PersonMode"
                                     IsChecked="{Binding PersonFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <!-- 0.2.39: jedes erkannte, nicht ignorierte Gesicht (benannt, Vorschlag oder unbenannt) -->
                        <RadioButton Content="alle Fotos mit Gesichtern" GroupName="PersonMode"
                                     AutomationProperties.Name="Alle Fotos mit Gesichtern"
                                     ToolTip="Fotos mit mindestens einem erkannten Gesicht — ignorierte Gesichter zählen nicht"
                                     IsChecked="{Binding PersonFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=AnyFace}" />
                        <RadioButton Content="nur Fotos ohne Person" GroupName="PersonMode"
                                     IsChecked="{Binding PersonFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=NoPerson}" />
                        <RadioButton Content="nur Fotos mit unbenannten Gesichtern" GroupName="PersonMode"
                                     IsChecked="{Binding PersonFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=UnnamedFaces}" />
                        <CheckBox Margin="0,6,0,0"
                                  Content="auch Vorschläge (noch nicht bestätigt)"
                                  IsChecked="{Binding PersonFilterIncludeSuggestions, Mode=TwoWay}"
                                  AutomationProperties.Name="Auch Vorschläge berücksichtigen" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="Zurücksetzen" Command="{Binding ClearPersonFilterCommand}" Click="OnCloseClick" Margin="0,0,6,0" />
                        <ui:Button Content="Schließen" Appearance="Primary" Click="OnCloseClick" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" MaxWidth="300"
                               Text="Noch keine Personen — Gesichter benennen auf der Seite „Personen“ oder in der Lightbox (Taste F)."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasPersons, Converter={StaticResource InvBoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PersonFilterEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PersonFilterEntry}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,1"
                                              Command="{Binding DataContext.ApplyPersonFilterCommand, ElementName=Root}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

<UserControl x:Class="PhotoViewerV3.Gallery.Controls.GallerySearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:PhotoViewerV3.Gallery.Converters"
             xmlns:vm="clr-namespace:PhotoViewerV3.Gallery.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GalleryViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="360"
             Focusable="False">
    <!-- Suche der Galerie (0.2.43; seit 0.4.1 eigenes Steuerelement für Galerie, Ordner und Orte, ADR-0055):
         Enter sucht sofort, sonst nach kurzer Tipp-Pause; Esc leert; Strg+F fokussiert (GalleryView). DataContext = GalleryViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ui:TextBox x:Name="SearchBox"
                    AutomationProperties.AutomationId="GallerySearchBox"
                    AutomationProperties.Name="Suche"
                    AutomationProperties.HelpText="Suche nach Dateiname, Tag, Person, Motiv oder Kategorie. Strg+F springt hierher, Enter sucht, Esc leert."
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Suchen: Name, Tag, Person, Motiv …"
                    ToolTip="Suche nach Dateiname, Endung, Tag, Person, Motiv, Kategorie oder Kategorie-Wert — „Motiv: Hund“ sucht nur Motive (Strg+F, Enter sucht, Esc leert)"
                    ClearButtonEnabled="False"
                    Padding="10,6,64,7"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
            </ui:TextBox.InputBindings>
        </ui:TextBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
            <!-- Tastenhinweis, solange das Feld leer ist -->
            <Border x:Name="SearchShortcutHint"
                    Padding="5,1"
                    CornerRadius="3"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Visibility="{Binding SearchTerm, Converter={StaticResource StringToVis}, ConverterParameter=Invert}">
                <TextBlock Text="Strg+F" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Border>
            <Button Style="{StaticResource ChipButton}"
                    Padding="6"
                    ToolTip="Suche leeren (Esc)"
                    AutomationProperties.Name="Suche leeren"
                    Command="{Binding ClearSearchCommand}"
                    Visibility="{Binding SearchTerm, Converter={StaticResource StringToVis}}">
                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

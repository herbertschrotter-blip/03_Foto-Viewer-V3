<UserControl x:Class="PhotoViewerV3.Gallery.Controls.GalleryStatusFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:PhotoViewerV3.Gallery.Converters"
             Focusable="False">
    <!--
        Status-Filter (ADR-0020) als Dropdown neben den Filter-Pills: „Nicht archiviert“ (Eingangs-Ordner) und
        „Archiviert“ (Archiv-Ordner). Gleiche Bindung wie früher die Pills: GalleryViewModel.Filter über EnumEquals
        (GalleryFilter.NotArchived / Archived / All). Der Knopf zeigt den aktiven Status-Filter in Akzentfarbe.
    -->
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      AutomationProperties.AutomationId="GalleryStatusFilterButton"
                      AutomationProperties.Name="Status-Filter"
                      ToolTip="Nach Ablage-Status filtern: noch im Eingang (unsortiert) oder schon in der Bibliothek"
                      Padding="10,4"
                      IsChecked="{Binding IsOpen, ElementName=StatusPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Archive24" FontSize="14" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Status" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="NotArchived">
                                    <Setter Property="Text" Value="Noch im Eingang" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Filter}" Value="Archived">
                                    <Setter Property="Text" Value="In der Bibliothek" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="StatusPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    MinWidth="240"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Ablage-Status" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <RadioButton GroupName="StatusFilter"
                                 Content="Alle Dateien"
                                 Click="OnOptionClick"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                    <RadioButton GroupName="StatusFilter"
                                 Click="OnOptionClick"
                                 AutomationProperties.Name="Noch im Eingang"
                                 ToolTip="Dateien in Eingängen (unsortierte Quellordner)"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=NotArchived}">
                        <StackPanel>
                            <TextBlock Text="Noch im Eingang" />
                            <TextBlock Text="Dateien in Eingängen (unsortierte Quellordner)" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="StatusFilter"
                                 Click="OnOptionClick"
                                 AutomationProperties.Name="In der Bibliothek"
                                 ToolTip="Dateien im Bibliotheksordner"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Archived}">
                        <StackPanel>
                            <TextBlock Text="In der Bibliothek" />
                            <TextBlock Text="Dateien im Bibliotheksordner" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

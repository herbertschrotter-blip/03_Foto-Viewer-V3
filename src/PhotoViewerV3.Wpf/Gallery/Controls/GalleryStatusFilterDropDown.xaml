<UserControl x:Class="PhotoViewerV3.Gallery.Controls.GalleryStatusFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gc="clr-namespace:PhotoViewerV3.Gallery.Controls"
             xmlns:vm="clr-namespace:PhotoViewerV3.Gallery.ViewModels"
             Focusable="False">
    <!--
        Chip „Ablage: …“ (ADR-0020/0041, bis 0.2.42 „Status“-Dropdown): Überall / Noch im Eingang / In der Bibliothek.
        Wirkt unabhängig von Dateiart, Favoriten und Bewertung (UND). DataContext = GalleryViewModel
        (LocationOptions, LocationFilter, LocationFilterText, HasLocationFilter).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      Style="{StaticResource GalleryFilterChip}"
                      AutomationProperties.AutomationId="GalleryStatusFilterButton"
                      AutomationProperties.Name="{Binding LocationFilterText, StringFormat='Ablage: {0}'}"
                      ToolTip="Nach Ablage filtern: noch im Eingang (unsortiert) oder schon in der Bibliothek"
                      gc:FilterChip.IsActive="{Binding HasLocationFilter}"
                      IsChecked="{Binding IsOpen, ElementName=StatusPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="MailInbox24" FontSize="13" Margin="0,0,5,0" />
                <TextBlock Text="Ablage:" Style="{StaticResource GalleryChipLabel}" />
                <TextBlock Text="{Binding LocationChipText}" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="5,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="StatusPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource GalleryFlyoutBorder}" MinWidth="260">
                <StackPanel>
                    <TextBlock Text="WO LIEGT DIE DATEI?" Style="{StaticResource GalleryFlyoutHeading}" />
                    <ListBox Style="{StaticResource GalleryFlyoutList}"
                             AutomationProperties.Name="Ablage"
                             ItemsSource="{Binding LocationOptions}"
                             SelectedValuePath="Location"
                             SelectedValue="{Binding LocationFilter, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="OnOptionChosen"
                             KeyDown="OnOptionKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource GalleryFlyoutListItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GalleryLocationOption}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource GalleryFlyoutHint}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

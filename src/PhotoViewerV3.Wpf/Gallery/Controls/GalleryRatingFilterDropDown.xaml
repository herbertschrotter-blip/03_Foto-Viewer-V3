<UserControl x:Class="PhotoViewerV3.Gallery.Controls.GalleryRatingFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gc="clr-namespace:PhotoViewerV3.Gallery.Controls"
             xmlns:vm="clr-namespace:PhotoViewerV3.Gallery.ViewModels"
             Focusable="False">
    <!--
        Chip „Bewertung: …“ (0.2.43, ADR-0041): egal / ab 1–4 Sternen / nur 5 Sterne (Files.Rating ≥ Wert). Wirkt mit UND
        zu allen anderen Filtern. DataContext = GalleryViewModel (RatingOptions, MinRating, RatingFilterText, HasRatingFilter).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      Style="{StaticResource GalleryFilterChip}"
                      AutomationProperties.AutomationId="GalleryRatingFilterButton"
                      AutomationProperties.Name="{Binding RatingFilterText, StringFormat='Bewertung: {0}'}"
                      ToolTip="Nach Bewertung filtern (Sterne)"
                      gc:FilterChip.IsActive="{Binding HasRatingFilter}"
                      IsChecked="{Binding IsOpen, ElementName=RatingPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Star24" FontSize="13" Margin="0,0,5,0" />
                <TextBlock Text="Bewertung:" Style="{StaticResource GalleryChipLabel}" />
                <TextBlock Text="{Binding RatingChipText}" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="5,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="RatingPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource GalleryFlyoutBorder}" MinWidth="200">
                <StackPanel>
                    <TextBlock Text="WIE GUT BEWERTET?" Style="{StaticResource GalleryFlyoutHeading}" />
                    <ListBox Style="{StaticResource GalleryFlyoutList}"
                             AutomationProperties.Name="Mindest-Bewertung"
                             ItemsSource="{Binding RatingOptions}"
                             SelectedValuePath="MinRating"
                             SelectedValue="{Binding MinRating, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="OnOptionChosen"
                             KeyDown="OnOptionKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource GalleryFlyoutListItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GalleryRatingOption}">
                                <StackPanel Orientation="Horizontal">
                                    <gc:RatingStars x:Name="Stars"
                                                    Value="{Binding Stars}"
                                                    StarSize="12"
                                                    IsHitTestVisible="False"
                                                    Focusable="False"
                                                    FilledBrush="#FFD166"
                                                    EmptyBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MinRating}" Value="0">
                                        <Setter TargetName="Stars" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

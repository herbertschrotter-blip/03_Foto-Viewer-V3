<UserControl x:Class="PhotoViewerV3.Gallery.Tags.TagFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:PhotoViewerV3.Gallery.Converters"
             xmlns:local="clr-namespace:PhotoViewerV3.Gallery.Tags"
             x:Name="Root"
             Focusable="False">
    <!--
        Tag-Filter neben den Filter-Pills: Knopf zeigt den aktiven Filter („Tags: Urlaub, Familie (UND)“), das Popup
        bietet je Tag ein Häkchen (mit Zähler), die Verknüpfung ODER/UND/ohne Tag und „Zurücksetzen“.
        DataContext = GalleryViewModel (TagFilterEntries, TagFilterMode, ApplyTagFilterCommand, ClearTagFilterCommand).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      AutomationProperties.AutomationId="GalleryTagFilterButton"
                      AutomationProperties.Name="Tag-Filter"
                      ToolTip="Nach Tags filtern"
                      Padding="10,4"
                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Tag24" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TagFilterText}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    MinWidth="260"
                    MaxHeight="420"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Verknüpfung" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                        <RadioButton Content="mindestens eines der Tags (ODER)" GroupName="TagMode"
                                     IsChecked="{Binding TagFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=Any}" />
                        <RadioButton Content="alle gewählten Tags (UND)" GroupName="TagMode"
                                     IsChecked="{Binding TagFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Content="nur Dateien ohne Tag" GroupName="TagMode"
                                     IsChecked="{Binding TagFilterMode, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="Zurücksetzen" Command="{Binding ClearTagFilterCommand}" Click="OnCloseClick" Margin="0,0,6,0" />
                        <ui:Button Content="Schließen" Appearance="Primary" Click="OnCloseClick" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Noch keine Tags — unter „Tags“ anlegen."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TagFilterEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TagFilterEntry}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,1"
                                              Command="{Binding DataContext.ApplyTagFilterCommand, ElementName=Root}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

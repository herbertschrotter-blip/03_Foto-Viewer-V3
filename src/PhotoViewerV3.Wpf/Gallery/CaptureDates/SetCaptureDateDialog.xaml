<dialogs:AppFluentWindow xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
        x:Class="PhotoViewerV3.Gallery.CaptureDates.SetCaptureDateDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PhotoViewerV3.Gallery.CaptureDates"
                 Title="Aufnahmedatum setzen"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- „Datum setzen…“ (ADR-0046): genau, ungefähr, verschieben oder zurücksetzen. Ändert nur den Katalog. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Aufnahmedatum setzen" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,16">
            <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="{Binding Request.Subject, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CountText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding CurrentText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
            <CheckBox Content="Unterordner einschließen"
                      Margin="0,8,0,0"
                      IsChecked="{Binding IncludeSubfolders}"
                      Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Unterordner einschließen" />

            <!-- Genau -->
            <RadioButton GroupName="CaptureMode" Margin="0,14,0,4" Content="Genaues Datum und Uhrzeit"
                         IsChecked="{Binding IsExact}" AutomationProperties.Name="Genaues Datum" />
            <StackPanel Orientation="Horizontal" Margin="28,0,0,0" IsEnabled="{Binding IsExact}">
                <DatePicker Width="170" SelectedDate="{Binding ExactDate}" AutomationProperties.Name="Datum" />
                <ui:TextBox Width="90" Margin="8,0,0,0" PlaceholderText="HH:mm"
                            Text="{Binding ExactTime, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Uhrzeit" />
            </StackPanel>

            <!-- Ungefähr -->
            <RadioButton GroupName="CaptureMode" Margin="0,12,0,4" Content="Ungefähr (z. B. „ca. 1982“)"
                         IsChecked="{Binding IsApproximate}" AutomationProperties.Name="Ungefähr" />
            <StackPanel Orientation="Horizontal" Margin="28,0,0,0" IsEnabled="{Binding IsApproximate}">
                <ui:TextBox Width="90" PlaceholderText="Jahr"
                            Text="{Binding ApproximateYear, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Jahr" />
                <ComboBox Width="170" Margin="8,0,0,0"
                          ItemsSource="{Binding MonthOptions}"
                          SelectedItem="{Binding ApproximateMonth}"
                          DisplayMemberPath="Label"
                          AutomationProperties.Name="Monat" />
            </StackPanel>

            <!-- Verschieben -->
            <RadioButton GroupName="CaptureMode" Margin="0,12,0,4" Content="Verschieben (falsch gestellte Kamera)"
                         IsChecked="{Binding IsShift}" AutomationProperties.Name="Verschieben" />
            <StackPanel Margin="28,0,0,0" IsEnabled="{Binding IsShift}">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Width="70" Text="{Binding ShiftDays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tage" />
                    <TextBlock Text="Tage" VerticalAlignment="Center" Margin="6,0,14,0" />
                    <ui:TextBox Width="70" Text="{Binding ShiftHours, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stunden" />
                    <TextBlock Text="Stunden" VerticalAlignment="Center" Margin="6,0,14,0" />
                    <ui:TextBox Width="70" Text="{Binding ShiftMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minuten" />
                    <TextBlock Text="Minuten" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Mit „-“ zurück, z. B. -1 Stunde, wenn die Kamera vorging. Basis ist das bisherige Aufnahmedatum (sonst das Änderungsdatum)." />
            </StackPanel>

            <!-- Zurücksetzen -->
            <RadioButton GroupName="CaptureMode" Margin="0,12,0,4" Content="Zurücksetzen — wieder aus der Datei lesen (EXIF, Video, Dateiname)"
                         IsChecked="{Binding IsReset}" AutomationProperties.Name="Zurücksetzen" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="Ändert nur den Katalog, nicht die Datei. „Rückgängig“ in der Galerie nimmt die Änderung zurück." />
            <TextBlock Text="{Binding ErrorText, Mode=OneWay}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="OkButton" MinWidth="120" Margin="0,0,8,0" Appearance="Primary" Content="Datum setzen"
                           IsEnabled="{Binding CanAccept}" Click="OnOkClick" />
                <ui:Button MinWidth="110" Content="Abbrechen" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

<ui:FluentWindow x:Class="PhotoViewerV3.Gallery.ArchiveTarget.ArchiveTargetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
                 xmlns:local="clr-namespace:PhotoViewerV3.Gallery.ArchiveTarget"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:ArchiveTargetViewModel}"
                 Width="620"
                 Height="640"
                 MinWidth="480"
                 MinHeight="420"
                 ResizeMode="CanResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- Dialog „Ins Archiv…“ (ADR-0020) nach dem Muster von Shell/Dialogs/AppDialogWindow: eigenes FluentWindow,
         feste Größe (Baum statt SizeToContent), Enter = Verschieben, Esc = Abbrechen. -->
    <ui:FluentWindow.Resources>
        <shell:BoolToVisibilityConverter x:Key="BoolToVis" />
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
        <shell:NullToBoolConverter x:Key="NullToBool" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Grid.Row="0"
                     Title="{Binding Title}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <!-- Kopf: Archiv-Wurzel, Suche, Ordner-Aktionen -->
        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis">
                <Run Text="Archiv: " /><Run Text="{Binding ArchiveRootPath, Mode=OneWay}" />
            </TextBlock>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox"
                            Grid.Column="0"
                            AutomationProperties.AutomationId="ArchiveSearchBox"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Ordner suchen…"
                            ClearButtonEnabled="True"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1"
                           Margin="8,0,0,0"
                           Content="Neuer Ordner"
                           Icon="{ui:SymbolIcon FolderAdd24}"
                           ToolTip="Unterordner im gewählten Ordner anlegen"
                           Command="{Binding CreateFolderCommand}" />
                <ui:Button Grid.Column="2"
                           Margin="8,0,0,0"
                           Content="Umbenennen"
                           Icon="{ui:SymbolIcon Rename24}"
                           ToolTip="Gewählten Ordner umbenennen"
                           Command="{Binding RenameFolderCommand}" />
            </Grid>
        </StackPanel>

        <!-- Baum bzw. Suchtreffer -->
        <Border Grid.Row="2"
                Margin="24,0,24,8"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <TreeView x:Name="FolderTree"
                          AutomationProperties.AutomationId="ArchiveFolderTree"
                          ItemsSource="{Binding Roots}"
                          BorderThickness="0"
                          Background="Transparent"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:ArchiveFolderNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <ui:SymbolIcon Symbol="Folder16"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Text="(nicht im Katalog)"
                                           Margin="8,0,0,0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding IsFileSystemOnly, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ListBox ItemsSource="{Binding SearchResults}"
                         BorderThickness="0"
                         Background="Transparent"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                         MouseDoubleClick="OnSearchHitDoubleClick"
                         SelectionChanged="OnSearchHitSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ArchiveFolderNode}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <ui:SymbolIcon Symbol="Folder16" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:ProgressRing IsIndeterminate="True"
                                 Width="28" Height="28"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Vorschlag + Ziel + Fehler -->
        <StackPanel Grid.Row="3" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding SuggestionText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1"
                           Content="Vorschlag übernehmen"
                           Icon="{ui:SymbolIcon CalendarMonth24}"
                           ToolTip="Jahr/Monat aus Aufnahme- bzw. Dateidatum als Zielordner (wird beim Verschieben angelegt)"
                           Command="{Binding UseSuggestionCommand}"
                           Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <TextBlock Text="{Binding TargetDisplay}"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding TargetPath}" />
            <ui:InfoBar Severity="Error"
                        IsClosable="False"
                        Margin="0,8,0,0"
                        Message="{Binding ErrorMessage}"
                        IsOpen="{Binding ErrorMessage, Converter={StaticResource NullToBool}, Mode=OneWay}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />
        </StackPanel>

        <Border Grid.Row="4"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PrimaryButton"
                           MinWidth="130"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Content="Verschieben"
                           Icon="{ui:SymbolIcon FolderArrowRight24}"
                           IsEnabled="{Binding CanConfirm}"
                           Click="OnPrimaryClick" />
                <ui:Button x:Name="CloseButton"
                           MinWidth="110"
                           Content="Abbrechen"
                           Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

<UserControl x:Class="PhotoViewerV3.Gallery.Categories.CategoryFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gc="clr-namespace:PhotoViewerV3.Gallery.Controls"
             xmlns:local="clr-namespace:PhotoViewerV3.Gallery.Categories"
             x:Name="Root"
             Focusable="False">
    <!--
        Chip „Kategorien: …“ in der Zeile „Inhalt“ (0.2.43; Filter seit ADR-0027): zeigt den aktiven Filter in Akzentfarbe
        („Kategorien: XX: N, NN · Projekt: ohne Wert“), das Flyout je Kategorie die Werte mit Zähler und „ohne Wert“ als
        Häkchen. Innerhalb einer Kategorie ODER, zwischen Kategorien UND. DataContext = GalleryViewModel
        (CategoryFilterGroups, CategoryFilterValueText, HasCategoryFilter, ApplyCategoryFilterCommand, ClearCategoryFilterCommand).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoViewerV3;component/Gallery/Controls/GalleryFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle"
                      Style="{StaticResource GalleryFilterChip}"
                      AutomationProperties.AutomationId="GalleryCategoryFilterButton"
                      AutomationProperties.Name="{Binding CategoryFilterValueText, StringFormat='Kategorien-Filter: {0}'}"
                      ToolTip="{Binding CategoryFilterText}"
                      gc:FilterChip.IsActive="{Binding HasCategoryFilter}"
                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Group24" FontSize="13" Margin="0,0,6,0" />
                <TextBlock Text="Kategorien:" Style="{StaticResource GalleryChipLabel}" />
                <TextBlock Text="{Binding CategoryFilterValueText}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Style="{StaticResource GalleryFlyoutBorder}" MinWidth="280" MaxHeight="480">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WELCHE WERTE?" Style="{StaticResource GalleryFlyoutHeading}" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource GalleryFlyoutHint}" MaxWidth="300"
                                   Text="In einer Kategorie: einer der gewählten Werte. Mehrere Kategorien: alle müssen passen." />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="Leeren" ToolTip="Kategorien-Filter aufheben" Command="{Binding ClearCategoryFilterCommand}" Click="OnCloseClick" Margin="0,0,6,0" />
                        <ui:Button Content="Fertig" Appearance="Primary" Click="OnCloseClick" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CategoryFilterGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CategoryFilterGroup}">
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:CategoryFilterEntry}">
                                                    <CheckBox x:Name="Check"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,1"
                                                              AutomationProperties.Name="{Binding Name}"
                                                              Command="{Binding DataContext.ApplyCategoryFilterCommand, ElementName=Root}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                            <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
                                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

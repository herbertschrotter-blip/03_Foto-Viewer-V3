<UserControl x:Class="PhotoViewerV3.Gallery.Categories.CategoryFilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PhotoViewerV3.Gallery.Categories"
             x:Name="Root"
             Focusable="False">
    <!--
        Kategorien-Filter neben dem Tag-Filter (ADR-0027): Knopf zeigt den aktiven Filter („XX: N, NN · Projekt: ohne Wert“),
        das Popup je Kategorie die Werte mit Zähler und „ohne Wert“ als Häkchen. Innerhalb einer Kategorie ODER, zwischen
        Kategorien UND. DataContext = GalleryViewModel (CategoryFilterGroups, ApplyCategoryFilterCommand, ClearCategoryFilterCommand).
    -->
    <Grid>
        <ToggleButton x:Name="Toggle"
                      AutomationProperties.AutomationId="GalleryCategoryFilterButton"
                      AutomationProperties.Name="Kategorien-Filter"
                      ToolTip="Nach Kategorien filtern"
                      Padding="10,4"
                      IsChecked="{Binding IsOpen, ElementName=FilterPopup, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Group24" FontSize="14" Margin="0,0,6,0" />
                <TextBlock Text="{Binding CategoryFilterText}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="FilterPopup"
               PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="0,4,0,0"
                    MinWidth="260"
                    MaxHeight="460"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11" TextWrapping="Wrap" MaxWidth="300"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Innerhalb einer Kategorie: einer der Werte. Mehrere Kategorien: alle müssen passen." />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Content="Zurücksetzen" Command="{Binding ClearCategoryFilterCommand}" Click="OnCloseClick" Margin="0,0,6,0" />
                        <ui:Button Content="Schließen" Appearance="Primary" Click="OnCloseClick" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CategoryFilterGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CategoryFilterGroup}">
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                        <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:CategoryFilterEntry}">
                                                    <CheckBox x:Name="Check"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,1"
                                                              Command="{Binding DataContext.ApplyCategoryFilterCommand, ElementName=Root}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                            <Setter TargetName="Label" Property="FontStyle" Value="Italic" />
                                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

<ui:FluentWindow x:Class="PhotoViewerV3.Gallery.Archives.ExtractArchiveDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PhotoViewerV3.Gallery.Archives"
                 xmlns:conv="clr-namespace:PhotoViewerV3.Gallery.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:ExtractArchiveDialogViewModel}"
                 Title="{Binding Title}"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- Entpacken-Dialog (ADR-0022) nach dem Muster von Shell/Dialogs/AppDialogWindow: feste Breite, Höhe aus dem Inhalt,
         keine Wpf.Ui MessageBox. Optionen oben, Fortschritt und Ergebnis unten, Knöpfe in der Fußzeile. -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,16">
            <TextBlock Text="{Binding TargetsText}"
                       ToolTip="{Binding TargetsText}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Zielordner -->
            <StackPanel IsEnabled="{Binding CanEditOptions}" Margin="0,14,0,0">
                <ui:TextBlock FontTypography="BodyStrong" Text="Zielordner" />
                <RadioButton GroupName="Target" Margin="0,6,0,0"
                             IsChecked="{Binding UseDefaultTarget}"
                             Content="Neben dem Archiv (Unterordner mit dem Archivnamen)" />
                <TextBlock Text="{Binding DefaultTargetHint}"
                           Margin="28,0,0,0"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DefaultTargetHint}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <RadioButton GroupName="Target" Margin="0,6,0,0"
                             IsChecked="{Binding UseCustomTarget}"
                             Content="Eigener Ordner:" />
                <Grid Margin="28,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding CustomTargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding UseCustomTarget}"
                                PlaceholderText="Ordner wählen…"
                                AutomationProperties.Name="Eigener Zielordner" />
                    <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Durchsuchen…"
                               Command="{Binding BrowseFolderCommand}" />
                </Grid>
                <TextBlock Text="{Binding CustomTargetHint}"
                           Margin="28,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <!-- Vorhandene Dateien -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Vorhandene Dateien" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton GroupName="Overwrite" Content="Überspringen" Margin="0,0,12,0"
                                 IsChecked="{Binding OverwriteMode, Converter={StaticResource EnumEquals}, ConverterParameter=Skip}" />
                    <RadioButton GroupName="Overwrite" Content="Überschreiben" Margin="0,0,12,0"
                                 IsChecked="{Binding OverwriteMode, Converter={StaticResource EnumEquals}, ConverterParameter=Overwrite}" />
                    <RadioButton GroupName="Overwrite" Content="Umbenennen (Name (2).jpg)"
                                 IsChecked="{Binding OverwriteMode, Converter={StaticResource EnumEquals}, ConverterParameter=Rename}" />
                </StackPanel>

                <!-- Optionen -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Optionen" Margin="0,14,0,0" />
                <CheckBox Content="Nur Fotos und Videos entpacken" Margin="0,4,0,0" IsChecked="{Binding MediaOnly}" />
                <CheckBox Content="Archive im Archiv mitentpacken (bis 3 Ebenen, werden danach entfernt)" IsChecked="{Binding ExtractNested}" />
                <CheckBox Content="Archiv danach in den Papierkorb verschieben (nur ohne Fehler)" IsChecked="{Binding RecycleAfterExtract}" />
            </StackPanel>

            <!-- Fortschritt / Ergebnis -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}" />
                <TextBlock Text="{Binding CurrentEntry}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding CurrentEntry, Converter={StaticResource StringToVis}}" />
                <TextBlock x:Name="ResultBlock" Text="{Binding ResultText}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Visibility="{Binding ResultText, Converter={StaticResource StringToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer MaxHeight="160" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ErrorLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="StartButton"
                           MinWidth="110"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Content="Entpacken"
                           Icon="{ui:SymbolIcon FolderZip24}"
                           Command="{Binding StartCommand}"
                           Visibility="{Binding CanEditOptions, Converter={StaticResource BoolToVis}}" />
                <ui:Button MinWidth="110"
                           Margin="0,0,8,0"
                           Content="Abbrechen"
                           Command="{Binding CancelCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <ui:Button x:Name="CloseButton"
                           MinWidth="110"
                           Content="Schließen"
                           Command="{Binding CloseCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

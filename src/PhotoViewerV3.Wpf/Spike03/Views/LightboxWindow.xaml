<ui:FluentWindow x:Class="PhotoViewerV3.Spike03.Views.LightboxWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
                 Title="Spike Lightbox"
                 Height="720"
                 Width="1280"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Spike Lightbox — Esc=schließen, F=Fullscreen-Toggle" />

        <vlc:VideoView Grid.Row="1"
                       x:Name="WindowVideo"
                       MediaPlayer="{Binding Player}" />

        <Border Grid.Row="2"
                Padding="10,6"
                Background="#80000000">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Play / Pause"
                           Command="{Binding PlayPauseCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Stop"
                           Command="{Binding StopPlaybackCommand}"
                           Margin="0,0,16,0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

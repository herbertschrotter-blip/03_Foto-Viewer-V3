<UserControl x:Class="PhotoViewerV3.Albums.FolderPageAlbumsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:PhotoViewerV3.Shell"
             xmlns:local="clr-namespace:PhotoViewerV3.Albums"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:FolderPageAlbumsViewModel}"
             x:Name="Root"
             Focusable="False">
    <!-- Alben unter dem Ordnerbaum (ADR-0054): Klick öffnet das Album in der Galerie rechts; Fotos aus der Galerie hierher
         ziehen = zum Album hinzufügen (verknüpfen). DataContext = FolderPageAlbumsViewModel. -->
    <UserControl.Resources>
        <shell:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="ALBEN" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Noch keine Alben — Fotos aus der Galerie per Rechtsklick „Zu Album hinzufügen“."
                   FontSize="11" Margin="4,0,0,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Gallery.AlbumFilterEntries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Gallery.AlbumFilterEntries}" Focusable="False"
                          AutomationProperties.AutomationId="FolderPageAlbums">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AlbumFilterEntry}">
                        <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Appearance="Transparent" Padding="6,3" Margin="0,1"
                                   AllowDrop="True"
                                   DragOver="OnAlbumDragOver"
                                   Drop="OnAlbumDrop"
                                   AutomationProperties.Name="{Binding Name}"
                                   ToolTip="Klicken öffnet das Album · Fotos hierher ziehen fügt sie hinzu (verknüpft, nicht kopiert)"
                                   Command="{Binding DataContext.OpenAlbumCommand, ElementName=Root}"
                                   CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Album20" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:SymbolIcon Symbol="Sparkle16" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSmart, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                <TextBlock Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="4,6,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="FolderPageDropStatus"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}" />
    </StackPanel>
</UserControl>

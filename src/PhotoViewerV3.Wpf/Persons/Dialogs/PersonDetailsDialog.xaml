<dialogs:AppFluentWindow xmlns:dialogs="clr-namespace:PhotoViewerV3.Shell.Dialogs"
                 x:Class="PhotoViewerV3.Persons.Dialogs.PersonDetailsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PhotoViewerV3.Persons.Dialogs"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:PersonDetailsEditor}"
                 Title="{Binding Title}"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 KeyDown="OnKeyDown">

    <!-- Person benennen / bearbeiten (0.2.47, ADR-0045): Vorname, Nachname, Rufname, Beziehung (Freitext mit
         Vorschlägen), Geburtsdatum (Tag/Monat optional), „Das bin ich“. Aufbau wie AppDialogWindow. Logik und Prüfung im
         PersonDetailsEditor (DataContext). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,16">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Vorname" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Vorname" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nachname" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Nachname" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Rufname (optional)" Margin="0,10,0,4" />
            <ui:TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="z. B. Opa Franz — wird statt Vor- und Nachname angezeigt"
                        AutomationProperties.Name="Rufname" />

            <TextBlock Text="Beziehung (aus deiner Sicht, optional)" Margin="0,10,0,4" />
            <ComboBox x:Name="RelationBox"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      IsTextSearchCaseSensitive="False"
                      StaysOpenOnEdit="True"
                      ItemsSource="{Binding Relations}"
                      Text="{Binding Relation, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Frei eintippen, z. B. „Schwester“, „Cousin mütterlicherseits“, „Taufpate“ — bereits verwendete werden vorgeschlagen"
                      AutomationProperties.Name="Beziehung" />

            <TextBlock Text="Geburtsdatum (optional, auch nur Jahr oder Monat und Jahr)" Margin="0,10,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="80" ItemsSource="{x:Static local:PersonDetailsEditor.Days}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding BirthDay, Mode=TwoWay}"
                          AutomationProperties.Name="Geburtstag (Tag)" />
                <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{x:Static local:PersonDetailsEditor.Months}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding BirthMonth, Mode=TwoWay}"
                          AutomationProperties.Name="Geburtsmonat" />
                <ui:TextBox Width="100" Margin="8,0,0,0" PlaceholderText="Jahr" MaxLength="4"
                            Text="{Binding BirthYear, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Geburtsjahr" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding AgeText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CheckBox Margin="0,12,0,0" Content="Das bin ich" IsChecked="{Binding IsMe}"
                      ToolTip="Höchstens eine Person — Grundlage für spätere Fragen wie „Fotos mit meiner Schwester aus meiner Kindheit“"
                      AutomationProperties.Name="Das bin ich" />
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding MeText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MeText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="{Binding DisplayNameText}"
                       AutomationProperties.AutomationId="PersonDisplayNamePreview" />
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding ExistingText}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExistingText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Error}"
                       AutomationProperties.AutomationId="PersonDetailsError"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button MinWidth="110"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Content="{Binding ConfirmText}"
                           IsEnabled="{Binding CanConfirm}"
                           Click="OnOkClick" />
                <ui:Button MinWidth="110" Content="Abbrechen" Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:AppFluentWindow>

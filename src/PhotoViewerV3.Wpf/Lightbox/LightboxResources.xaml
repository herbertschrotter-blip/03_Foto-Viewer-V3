<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PhotoViewerV3.Lightbox.Converters">

    <!--
        Lightbox-Oberfläche: immersiv schwarz, unabhängig vom Hell/Dunkel-Theme der App.
        Die Brushes werden ausschließlich per DynamicResource referenziert; das Dictionary wird
        sowohl vom Fenster als auch vom Overlay gemergt, weil das Video-Overlay in LibVLCSharps
        transparentem Vordergrundfenster lebt und die Fenster-Ressourcen dort nicht erreicht.
    -->
    <SolidColorBrush x:Key="LightboxBackgroundBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="LightboxTextBrush" Color="#E4E7EB" />
    <SolidColorBrush x:Key="LightboxTextSecondaryBrush" Color="#A0AEC0" />
    <SolidColorBrush x:Key="LightboxChromeBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="LightboxPanelBrush" Color="#F214161C" />
    <SolidColorBrush x:Key="LightboxPanelBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="LightboxChipBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="LightboxHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="LightboxPressedBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="LightboxNavBrush" Color="#80000000" />
    <SolidColorBrush x:Key="LightboxNavBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="LightboxFavoriteBrush" Color="#F87171" />
    <SolidColorBrush x:Key="LightboxStarBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="LightboxDangerHoverBrush" Color="#33EF4444" />
    <SolidColorBrush x:Key="LightboxErrorBrush" Color="#F87171" />

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:RatingAtLeastConverter x:Key="RatingAtLeast" />

    <!-- Flache Overlay-Schaltfläche (eigenes Template: vorhersehbar auf Schwarz, kein Fokusraub) -->
    <Style x:Key="LightboxOverlayButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource LightboxTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightboxHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightboxPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Runde Navigationspfeile links/rechts -->
    <Style x:Key="LightboxNavButton" TargetType="Button" BasedOn="{StaticResource LightboxOverlayButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource LightboxNavBrush}"
                            BorderBrush="{DynamicResource LightboxNavBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="26">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightboxHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightboxPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightboxOverlayText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LightboxTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LightboxSlider" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
